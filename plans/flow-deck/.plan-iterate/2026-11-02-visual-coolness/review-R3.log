it Promise.all([\r\n125:         base.unstaged.length + base.conflicts.length > 0 ? run(['diff', '--no-ext-diff', '--no-textconv', '--numstat']) : null,\r\n126:         base.staged.length > 0 ? run(['diff', '--cached', '--no-ext-diff', '--no-textconv', '--numstat']) : null,\r\n127:       ])\r\n128:       status = buildGitStatus(porcelain, parseNumstat(worktree ?? ''), parseNumstat(cached ?? ''), now)\r\n129:       nextAt = now + (porcelain.files.length > 0 ? GIT_ACTIVE_MS : GIT_IDLE_MS)\r\n130:     } else {\r\n131:       nextAt = now + GIT_RETRY_MS\r\n132:     }\r\n133:     const key = gitSnapshotKey(status)\r\n134:     if (key !== previous) {\r\n135:       await publish(status)\r\n136:       previous = key\r\n137:     }\r\n138:   }\r\n139:   return (now: number, force = false): Promise<void> => {\r\n140:     if (inFlight) return inFlight\r\n141:     inFlight = poll(now, force).finally(() => { inFlight = undefined })\r\n142:     return inFlight\r\n143:   }\r\n\r\n### plugins/flow-deck/hooks/register.tsx\r\n755:   guardMode = options.guardMode === 'deny' ? 'deny' : 'warn'\r\n756:   autoOpenMode = options.autoOpen === 'off' ? 'off' : 'on'\r\n757: \r\n758:   on('session.start', async ($, e, next) => {\r\n759:     sessionCwd = e.cwd\r\n760:     lastStatus = undefined\r\n761:     await update($, currentTask, () => null)\r\n762:     await update($, execution, () => null)\r\n763:     await update($, batchScope, () => null)\r\n764:     await update($, plans, () => [])\r\n765:     await update($, notified, () => [])\r\n766:     await update($, guardWarned, () => [])\r\n767:     await update($, baselined, () => false)\r\n768:     await update($, progress, () => ({}))\r\n769:     await update($, deps, () => null)\r\n770:     await update($, agents, () => ({ agents: [], loaded: false, error: false }))\r\n771:     await update($, stall, () => null)\r\n772:     await update($, docFile, () => null)\r\n773:     await update($, docSection, () => 0)\r\n774:     await update($, docMode, () => 'all')\r\n775:     await update($, treeDir, () => null)\r\n776:     await update($, treeEntries, () => null)\r\n777:     await update($, touched, () => [])\r\n778:     autoOpened = false\r\n779:     manualDeck = false\r\n780:     planTimer?.cancel()\r\n781:     gitTimer?.cancel()\r\n782:     scanPlans = createPlanScanner({\r\n955:   on('tool.call', { tool: 'mcp__flow-deck__flow_task' }, async ($, e) => {\r\n956:     if (e.kind !== 'iterate' && e.kind !== 'implement' && e.kind !== 'idle') {\r\n957:       return { result: 'kind 必须为 iterate、implement 或 idle', isError: true }\r\n958:     }\r\n959:     if (e.kind !== 'idle' && (typeof e.plan !== 'string' || e.plan.trim() === '')) {\r\n960:       return { result: '活动任务必须提供 plan', isError: true }\r\n961:     }\r\n962:     const task: FlowTask | null = e.kind === 'idle' ? null : {\r\n963:       kind: e.kind, plan: e.plan as string,\r\n964:       ...(typeof e.batch === 'string' && e.batch !== '' ? { batch: e.batch } : {}),\r\n965:     }\r\n966:     await update($, execution, () => null)\r\n967:     await update($, batchScope, () => null)\r\n968:     await update($, currentTask, () => task)\r\n969:     lastStatus = undefined\r\n970:     $.ui.status(undefined)\r\n971:     return { result: task === null ? '当前任务已结束' : `当前任务：${task.kind === 'iterate' ? '方案迭代' : '方案实施'} · ${task.plan}` }\r\n972:   })\r\n973: \r\n974:   on('tool.call', { tool: 'mcp__flow-deck__flow_report' }, async ($, e) => {\r\n975:     const report = parseExecution(e)\r\n976:     if (report === null) {\r\n977:       return { result: 'plan、batch、phase 为必填字符串', isError: true }\r\n978:     }\r\n979:     const stamped: ExecutionReport = { ...report, updatedAt: Date.now() }\r\n980:     await update($, execution, () => stamped)\r\n981:     await update($, progress, prev => ({\r\n982:       ...prev,\r\n983:       [`${stamped.plan}#${stamped.batch}`]: stamped.phase,\r\n984:     }))\r\n985:     await update($, currentTask, () => stamped.phase === '收口' ? null : {\r\n986:       kind: 'implement', plan: stamped.plan, batch: stamped.batch,\r\n987:     })\r\n988:     const scope = await read($, batchScope)\r\n989:     if (stamped.phase === '收口' || (scope !== null && (scope.plan !== stamped.plan || scope.batch !== stamped.batch))) {\r\n990:       await update($, batchScope, () => null)\r\n991:     }\r\n992:     lastStatus = undefined\r\n993:     $.ui.status(undefined)\r\n994:     try {\r\n995:       await $.store.set(EXECUTION_STORE_KEY, stamped)\r\n996:     } catch (error) {\r\n997:       $.ui.log(`flow-deck 跨会话持久化失败：${String(error)}`, { to: 'debug' })\r\n998:     }\r\n999:     return { result: '进度已上报' }\r\n1000:   })\r\n1001: \r\n1002:   on('tool.call', { tool: 'mcp__flow-deck__flow_batch' }, async ($, e) => {\r\n1003:     const scope = parseBatchScope(e)\r\n1004:     if (scope === null) {\r\n1005:       return { result: 'plan、batch 为必填字符串，files 为非空字符串数组', isError: true }\r\n1006:     }\r\n1007:     await update($, batchScope, () => scope)\r\n1008:     // 边界变了越界集合随之变化，应允许再次提醒\r\n1009:     await update($, guardWarned, () => [])\r\n1010:     await update($, currentTask, () => ({ kind: 'implement', plan: scope.plan, batch: scope.batch }))\r\n1011:     lastStatus = undefined\r\n1012:     $.ui.status(undefined)\r\n1013:     return { result: `批次边界已声明：${scope.batch} 共 ${scope.files.length} 个文件` }\r\n1014:   })\r\n\r\n### plugins/flow-deck/hooks/parse.ts\r\n275: /** 校验并归一化 flow_report 上报（来自模型工具入参或 $.store 旧值），不符返回 null */\r\n276: export function parseExecution(value: unknown): ExecutionReport | null {\r\n277:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return null\r\n278:   const record = value as Record<string, unknown>\r\n279:   if (typeof record.plan !== 'string' || record.plan === '') return null\r\n280:   if (typeof record.batch !== 'string' || record.batch === '') return null\r\n281:   if (typeof record.phase !== 'string' || record.phase === '') return null\r\n282:   const report: ExecutionReport = {\r\n283:     plan: record.plan,\r\n284:     batch: record.batch,\r\n285:     phase: record.phase,\r\n286:     updatedAt: typeof record.updatedAt === 'number' ? record.updatedAt : 0,\r\n287:   }\r\n288:   if (typeof record.tLevel === 'string') report.tLevel = record.tLevel\r\n289:   if (typeof record.testsPassed === 'number') report.testsPassed = record.testsPassed\r\n290:   if (typeof record.testsTotal === 'number') report.testsTotal = record.testsTotal\r\n291:   if (typeof record.evidenceDir === 'string') report.evidenceDir = record.evidenceDir\r\n292:   return report\r\n293: }\r\n294: \r\n295: /** 校验并归一化 flow_batch 边界声明，不符返回 null */\r\n296: export function parseBatchScope(value: unknown): BatchScope | null {\r\n297:   if (typeof value !== 'object' || value === null || Array.isArray(value)) return null\r\n298:   const record = value as Record<string, unknown>\r\n299:   if (typeof record.plan !== 'string' || record.plan === '') return null\r\n300:   if (typeof record.batch !== 'string' || record.batch === '') return null\r\n301:   if (!Array.isArray(record.files)) return null\r\n302:   const files = record.files.filter((file): file is string => typeof file === 'string' && file !== '')\r\n303:   return { plan: record.plan, batch: record.batch, files }\r\n304: }\r\n305: \r\n306: /** 路径归一化：反斜杠转正斜杠；绝对路径剥掉工作目录前缀（大小写不敏感比较） */\r\n307: export function normalizePath(path: string, cwd: string): string {\r\n308:   const unified = path.replace(/\\\\/g, '/')\r\n309:   const cwdUnified = cwd.replace(/\\\\/g, '/').replace(/\\/+$/, '')\r\n310:   if (cwdUnified !== '' && unified.toLowerCase().startsWith(`${cwdUnified.toLowerCase()}/`)) {\r\n311:     return unified.slice(cwdUnified.length + 1)\r\n312:   }\r\n313:   return unified\r\n363: export function depStatuses(graph: DepGraph, progress: Record<string, string>): DepNode[] {\r\n364:   return graph.batches.map(node => {\r\n365:     const phase = progress[`${graph.plan}#${node.batch}`]\r\n366:     if (phase === undefined) return { ...node, status: 'pending' as const }\r\n367:     return { ...node, status: phase === '收口' ? ('done' as const) : ('active' as const) }\r\n368:   })\r\n423: function unquotePath(path: string): string {\r\n424:   if (path.startsWith('\"') && path.endsWith('\"') && path.length >= 2) {\r\n425:     return path.slice(1, -1)\r\n426:   }\r\n427:   return path\r\n428: }\r\n429: \r\n430: /** 解析 git status --porcelain=v1 -b 的 stdout；无 ## 头行（非 git 仓库输出）返回 null */\r\n431: export function parsePorcelain(stdout: string): PorcelainStatus | null {\r\n432:   const header = stdout.split('\\n').find(line => line.startsWith('## '))\r\n433:   if (header === undefined) return null\r\n434: \r\n435:   // 头行变体：## main / ## main...origin/main [ahead 2, behind 1] /\r\n436:   // ## No commits yet on main（unborn）/ ## HEAD (no branch)（detached）\r\n437:   const body = header.slice(3).trim()\r\n438:   let branch: string\r\n439:   let upstream: string | null = null\r\n440:   let ahead = 0\r\n441:   let behind = 0\r\n442:   if (body === 'HEAD (no branch)') {\r\n443:     branch = 'HEAD*'\r\n444:   } else if (body.startsWith('No commits yet on ')) {\r\n445:     branch = body.slice('No commits yet on '.length)\r\n446:   } else {\r\n447:     const dots = body.indexOf('...')\r\n448:     if (dots === -1) {\r\n449:       branch = body\r\n450:     } else {\r\n451:       branch = body.slice(0, dots)\r\n452:       const rest = body.slice(dots + 3)\r\n453:       const bracket = rest.indexOf(' [')\r\n454:       upstream = bracket === -1 ? rest : rest.slice(0, bracket)\r\n455:       const marks = bracket === -1 ? '' : rest.slice(bracket + 2, rest.lastIndexOf(']'))\r\n456:       const aheadMatch = /\\bahead (\\d+)/.exec(marks)\r\n457:       const behindMatch = /\\bbehind (\\d+)/.exec(marks)\r\n458:       if (aheadMatch !== null) ahead = Number(aheadMatch[1])\r\n459:       if (behindMatch !== null) behind = Number(behindMatch[1])\r\n460:     }\r\n461:   }\r\n462: \r\n463:   const files: PorcelainFile[] = []\r\n464:   for (const line of stdout.split('\\n')) {\r\n465:     if (line === '' || line.startsWith('## ')) continue\r\n466:     const code = line.slice(0, 2)\r\n467:     const rest = line.slice(3)\r\n468:     if (rest === '') continue\r\n469:     const arrow = rest.indexOf(' -> ')\r\n470:     if (arrow !== -1) {\r\n471:       files.push({\r\n472:         code,\r\n473:         path: unquotePath(rest.slice(arrow + 4)),\r\n474:         oldPath: unquotePath(rest.slice(0, arrow)),\r\n475:       })\r\n476:     } else {\r\n477:       files.push({ code, path: unquotePath(rest) })\r\n478:     }\r\n479:   }\r\n480:   return { branch, upstream, ahead, behind, files }\r\n481: }\r\n482: \r\n483: /** 解析 git diff --numstat 的 stdout，累加行级增删；二进制行（-\\t-）与非法行跳过 */\r\n484: export function parseNumstat(stdout: string): { added: number; removed: number } {\r\n485:   let added = 0\r\n486:   let removed = 0\r\n487:   for (const line of stdout.split('\\n')) {\r\n488:     const parts = line.split('\\t')\r\n489:     if (parts.length < 3) continue\r\n490:     const lineAdded = Number(parts[0])\r\n491:     const lineRemoved = Number(parts[1])\r\n492:     if (!Number.isNaN(lineAdded)) added += lineAdded\r\n493:     if (!Number.isNaN(lineRemoved)) removed += lineRemoved\r\n494:   }\r\n495:   return { added, removed }\r\n\r\n### plugins/rulertu-flow/skills/implement-plan/SKILL.md\r\n14: ## 进度上报\r\n15: \r\n16: 会话有 `mcp__flow-deck__flow_task` 时，每批开工检查前用 `kind: \"implement\"`、`plan`、`batch` 声明当前任务。正常收口由 `flow_report` 自动撤下面板；实施失败停止、暂停或取消时调用 `kind: \"idle\"`。无该工具时静默跳过，恢复实施时重新声明。\r\n17: \r\n18: 会话中存在 `mcp__flow-deck__flow_report` 工具时，每批的开工、派单、执行、验证、收口各阶段完成即调用上报：`plan`（方案名）、`batch`（批次标识）、`phase`（阶段）必填，`tLevel`、`testsPassed`/`testsTotal`、`evidenceDir` 按实填写。工具不存在时静默跳过，不补报、不重试。上报只是进度展示，不替代任何验证义务。\r\n19: \r\n20: 会话中存在 `mcp__flow-deck__flow_batch` 工具时，每批派单完成后调用一次，把委派单的改动锚点展开为本批允许改动的文件清单（`plan`、`batch`、`files`）声明边界；此后对边界外文件的编辑会被守卫提醒或拦截，确需改动时先更新边界再动工。工具不存在时静默跳过，边界声明不改变任何验证义务。\r\n","exit_code":0,"status":"completed"}}
