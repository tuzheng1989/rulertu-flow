的批次合规标注（紧凑行自绘）：界内 ◆、越界放行 ⚠、拦截 ✗；\r\n1091   // ctrl+o 展开态、中断行与真实错误行透传引擎原样；判定与守卫同一口径（guardDecision）\r\n1092   on('ui.render', { component: 'ToolUse' }, async ($, e, next) => {\r\n1093     const tool = e.props.tool\r\n1094     if (tool !== 'Edit' && tool !== 'Write') return next(e)\r\n1095     const scope = await read($, batchScope)\r\n1096     const task = await read($, currentTask)\r\n1097     const active = scope !== null && sessionCwd !== '' && task?.kind === 'implement' &&\r\n1098       task.plan === scope.plan && (task.batch === undefined || task.batch === scope.batch)\r\n1099     const decision = active\r\n1100       ? guardDecision(scope, tool, e.props.input, sessionCwd)\r\n1101       : ({ kind: 'pass' } as const)\r\n1102     const intercepted = decision.kind === 'outOfScope' && guardMode === 'deny'\r\n1103     if (e.props.isExpanded === true || e.props.isInterrupted === true ||\r\n1104         (e.props.isErrored === true && !intercepted)) return next(e)\r\n1105     const mark = toolMark(active, decision.kind === 'outOfScope', guardMode)\r\n1106     const input = e.props.input as { file_path?: unknown }\r\n1107     const rawPath = typeof input.file_path === 'string' ? input.file_path : ''\r\n1108     const path = sessionCwd === '' ? rawPath : normalizePath(rawPath, sessionCwd)\r\n1109     const { Box, Text } = $.ui.resolve(e)\r\n1110     const inBoundary = active && decision.kind === 'pass'\r\n1111     return (\r\n1112       <Box>\r\n1113         <Text wrap=\"truncate-end\">\r\n1114           <Text bold>{tool}</Text>\r\n1115           {rawPath === ''\r\n1116             ? <Text dimColor> {tool === 'Edit' ? '编辑中…' : '写入中…'}</Text>\r\n1117             : <Text> {path}</Text>}\r\n1118           {inBoundary && <Text color={TONE.accent}> {MARK.pin}</Text>}\r\n1119           {mark !== null && <Text color={mark.tone === 'bad' ? TONE.bad : mark.tone === 'warn' ? TONE.warn : TONE.accent}> {mark.text}</Text>}\r\n1120           {e.props.isRunning === true && <Text dimColor> ·</Text>}\r\n1121         </Text>\r\n1122       </Box>\r\n1123     )\r\n1124   })\r\n1125 \r\n1126   // 输入框守卫预览：实施中有边界时，草稿里的路径 token 实时标色（界内绿/越界黄），\r\n1127   // 把守卫从「事后拦截」提前到「打字时可见」；paint 只挂本插件的装饰，草稿一改即失效重画\r\n1128   on('prompt.edit', { origin: { kind: 'composer' } }, async ($, e, next) => {\r\n1129     const scope = await read($, batchScope)\r\n1130     const task = await read($, currentTask)\r\n1131     const active = scope !== null && sessionCwd !== '' && task?.kind === 'implement' &&\r\n1132       task.plan === scope.plan && (task.batch === undefined || task.batch === scope.batch)\r\n1133     let decorations: PromptDecoration[] = []\r\n1134     if (active) {\r\n1135       const keys = new Set(scope.files.map(file => normalizePath(file, sessionCwd).toLowerCase()))\r\n1136       decorations = draftDecorations(e.text, keys, sessionCwd).map(row => ({\r\n1137         start: row.start,\r\n1138         end: row.end,\r\n1139         color: row.inScope ? TONE.ok : TONE.warn,\r\n1140         underline: row.inScope ? undefined : true,\r\n1141       }))\r\n1142     }\r\n1143     try {\r\n1144       await $.prompt.paint({ text: e.text, decorations })\r\n1145     } catch (error) {\r\n1146       $.ui.log(`flow-deck 输入框预览失败：${String(error)}`, { to: 'debug' })\r\n1147     }\r\n1148     return next(e)\r\n1149   })\r\n1150 \r\n1151   // 后台任务完成通知行（含子代理收尾）：状态点 + 名称 + 耗时；ctrl+o 展开态透传引擎原样\r\n1152   on('ui.render', { component: 'UserMessage', props: { origin: { kind: 'task-notification' } } }, async ($, e, next) => {\r\n1153     if (e.props.isExpanded === true) return next(e)\r\n1154     const task = e.props.task\r\n1155     const name = e.props.from?.name ?? task?.id ?? '后台任务'\r\n1156     const duration = task?.durationMs === undefined ? '' : ` · ${humanDuration(task.durationMs)}`\r\n1157     const status = task?.status\r\n1158     const mark = status === 'completed'\r\n1159       ? { glyph: MARK.done, color: TONE.ok as string | undefined }\r\n1160       : status === 'failed'\r\n1161         ? { glyph: MARK.bad, color: TONE.bad }\r\n1162         : { glyph: MARK.idle, color: undefined }\r\n1163     const { Box, Text } = $.ui.resolve(e)\r\n1164     return (\r\n1165       <Box>\r\n1166         <Text wrap=\"truncate-end\">\r\n1167           <Text color={mark.color}>{mark.glyph}</Text>\r\n1168           <Text> {name}</Text>\r\n1169           {duration !== '' && <Text dimColor>{duration}</Text>}\r\n1170         </Text>\r\n1171       </Box>\r\n1172     )\r\n1173   })\r\n1174 \r\n1175   on('ui.render', { component: 'AbovePrompt' }, async ($, e, next) => {\r\n1176     if (typeof e.viewport?.isFullscreen === 'boolean') lastFullscreen = e.viewport.isFullscreen\r\n1177     if (e.props.hasSurvey) return next(e)\r\n1178     if (e.props.maxRows < 1) return next(e)\r\n1179     const { report, scope } = await readTaskView($)\r\n1180     const git = await read($, gitStatus)\r\n1181     // 工作区干净且与上游同步时不占横条\r\n1182     const gitLine = git !== null && !isGitQuiet(git) ? git : null\r\n1183     if (report === null && scope === null && gitLine === null) return next(e)\r\n1184     const { counts, lines } = gitLine === null ? { counts: null, lines: null } : gitSummaryParts(gitLine)\r\n1185     const { Box, Text } = $.ui.resolve(e)\r\n1186     // 单行空间优先展示冲突，否则保留执行；截断长行，避免挤占输入区。\r\n1187     const showGit = gitLine !== null && (e.props.maxRows >= 2 || (report === null && scope === null) || gitLine.conflicts.length > 0)\r\n1188     const showFlow = e.props.maxRows >= 2 || !showGit\r\n1189     return (\r\n1190       <Box flexDirection=\"column\">\r\n1191         {showFlow && report !== null && (\r\n1192           <Text wrap=\"truncate-end\">\r\n1193             <Text color={TONE.accent}>{MARK.run} flow </Text>\r\n1194             <Text>{describeExecution(report)}</Text>\r\n1195             {scope !== null && scope.plan === report.plan && scope.batch === report.batch && <Text dimColor> · 守卫 {scope.files.length} 文件</Text>}\r\n1196           </Text>\r\n1197         )}\r\n1198         {showFlow && report === null && scope !== null && (\r\n1199           <Text dimColor wrap=\"truncate-end\">\r\n1200             ▸ {scope.plan} · {scope.batch} · 守卫 {scope.files.length} 文件\r\n1201           </Text>\r\n1202         )}\r\n1203         {showGit && gitLine !== null && (\r\n1204           <Text wrap=\"truncate-end\">\r\n1205             <Text color={gitLine.conflicts.length > 0 ? TONE.bad : TONE.accent}>{MARK.info} git </Text>\r\n1206             {gitLine.conflicts.length > 0 && <Text color={TONE.bad}>{MARK.bad}冲突{gitLine.conflicts.length} · </Text>}\r\n1207             <Text>{gitLine.branch}</Text>\r\n1208             {gitLine.ahead > 0 && <Text color={TONE.ok}> ↑{gitLine.ahead}</Text>}\r\n1209             {gitLine.behind > 0 && <Text color={TONE.warn}> ↓{gitLine.behind}</Text>}\r\n1210             {counts !== null && <Text dimColor> · {counts}</Text>}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -NoProfile -Command \"python -X utf8 -c \\\"from pathlib import Path; p=Path('plugins/flow-deck/hooks/register.tsx'); lines=p.read_text(encoding='utf-8').splitlines(); print('\\\\n'.join(f'{i+1:4} {x}' for i,x in enumerate(lines) if i<220 or 340<=i<550))\\\"\"","aggregated_output":"   1 import { atom, read, update } from 'claude-code'\r\n   2 import type { EngineInterface, MatchedHook, PromptDecoration, Register } from 'claude-code'\r\n   3 \r\n   4 import {\r\n   5   DOC_SECTION_MAX_LINES,\r\n   6   DOC_ALL_MAX_LINES,\r\n   7   bannerPlan,\r\n   8   collectChanges,\r\n   9   depStatuses,\r\n  10   gitSummaryParts,\r\n  11   guardDecision,\r\n  12   isGitQuiet,\r\n  13   normalizePath,\r\n  14   parseBatchScope,\r\n  15   parseDepGraph,\r\n  16   parseExecution,\r\n  17   parseSections,\r\n  18   phaseProgress,\r\n  19   pipelineLinks,\r\n  20   progressBar,\r\n  21   scoreGauge,\r\n  22   selectTaskView,\r\n  23   sortEntries,\r\n  24   sparkline,\r\n  25   spinnerWord,\r\n  26   toolMark,\r\n  27   draftDecorations,\r\n  28   humanDuration,\r\n  29   enhanceMarkdown,\r\n  30   pagerWindow,\r\n  31 } from './parse'\r\n  32 import { createGitPoller, createPlanScanner, singleFlight } from './poll'\r\n  33 import { agentStatus, agentSummary, createAgentPoller } from './agents'\r\n  34 import { MARK, TONE } from './ui'\r\n  35 import type { ChangeState } from './parse'\r\n  36 import type {\r\n  37   BatchScope,\r\n  38   ExecutionReport,\r\n  39   FlowTask,\r\n  40   FsEntryLike,\r\n  41   GitStatus,\r\n  42   PlanReview,\r\n  43 } from '../types'\r\n  44 \r\n  45 /** ui.render Pane 站点的事件入参（渲染辅助函数的 e 类型） */\r\n  46 type PaneArgs = Parameters<MatchedHook<'ui.render', { component: 'Pane' }>>[1]\r\n  47 \r\n  48 const DECK_PANE_ID = 'deck'\r\n  49 const DECK_TITLE = 'Deck'\r\n  50 /** 本会话改动记录上限；超出挤出最旧 */\r\n  51 const TOUCHED_CAP = 50\r\n  52 const POLL_MS = 2000\r\n  53 const GIT_POLL_MS = 5000\r\n  54 const GIT_TIMEOUT_MS = 5000\r\n  55 const EXECUTION_STORE_KEY = 'lastExecution'\r\n  56 /** 执行上报停滞阈值：超过该时长未续报视为疑似停滞 */\r\n  57 const STALL_MS = 30 * 60_000\r\n  58 \r\n  59 const plans = atom({ plugin: 'flow-deck', key: 'plans' } as const, [])\r\n  60 const notified = atom({ plugin: 'flow-deck', key: 'notified' } as const, [])\r\n  61 const baselined = atom({ plugin: 'flow-deck', key: 'baselined' } as const, false)\r\n  62 const execution = atom({ plugin: 'flow-deck', key: 'execution' } as const, null)\r\n  63 const currentTask = atom({ plugin: 'flow-deck', key: 'currentTask' } as const, null)\r\n  64 const batchScope = atom({ plugin: 'flow-deck', key: 'batchScope' } as const, null)\r\n  65 const guardWarned = atom({ plugin: 'flow-deck', key: 'guardWarned' } as const, [])\r\n  66 const progress = atom({ plugin: 'flow-deck', key: 'progress' } as const, {})\r\n  67 const deps = atom({ plugin: 'flow-deck', key: 'deps' } as const, null)\r\n  68 const gitStatus = atom({ plugin: 'flow-deck', key: 'git' } as const, null)\r\n  69 const agents = atom({ plugin: 'flow-deck', key: 'agents' } as const, { agents: [], loaded: false, error: false })\r\n  70 const lastRun = atom({ plugin: 'flow-deck', key: 'lastRun' } as const, null)\r\n  71 const stall = atom({ plugin: 'flow-deck', key: 'stall' } as const, null)\r\n  72 /** 文档浏览面板装载的文档：text 为 null 表示读取失败（error 记原因） */\r\n  73 const docFile = atom({ plugin: 'flow-deck', key: 'doc' } as const, null)\r\n  74 /** 文档浏览面板当前选中节在 parseSections 结果中的下标 */\r\n  75 const docSection = atom({ plugin: 'flow-deck', key: 'docSection' } as const, 0)\r\n  76 /** 文档浏览模式：all 全文阅读（默认），section 单节浏览（修改请求锚定） */\r\n  77 const docMode = atom({ plugin: 'flow-deck', key: 'docMode' } as const, 'all')\r\n  78 /** deck 面板当前页签；/deck 无参打开时保持上次所在页签 */\r\n  79 const activeTab = atom({ plugin: 'flow-deck', key: 'activeTab' } as const, 'flow')\r\n  80 /** 文件树面板当前浏览目录（相对会话工作目录）；null 表示根 */\r\n  81 const treeDir = atom({ plugin: 'flow-deck', key: 'treeDir' } as const, null)\r\n  82 /** 文件树面板最近一次目录列表；loaded 表示已取数（含空目录） */\r\n  83 const treeEntries = atom({ plugin: 'flow-deck', key: 'treeEntries' } as const, null)\r\n  84 /** 本会话 Edit/Write 改动记录（去重保序，最新在末尾） */\r\n  85 const touched = atom({ plugin: 'flow-deck', key: 'touched' } as const, [])\r\n  86 \r\n  87 /** 上次写入 statusline 的文案；仅用于跳过重复写入（热加载后重算一次无妨） */\r\n  88 let lastStatus: string | undefined\r\n  89 \r\n  90 /** 越界改动处理模式；register 时按 userConfig 覆盖（引擎要求钩子处于文件顶层，经此间接读取配置） */\r\n  91 let guardMode: 'warn' | 'deny' = 'warn'\r\n  92 \r\n  93 /** 会话工作目录；tool.call 事件不带 cwd，自 session.start 缓存（先于首个工具调用触发） */\r\n  94 let sessionCwd = ''\r\n  95 let scanPlans: ReturnType<typeof createPlanScanner> | undefined\r\n  96 let refreshGit: (() => Promise<void>) | undefined\r\n  97 let refreshAgents: (() => Promise<void>) | undefined\r\n  98 /** 面板「刷新」按钮的全部数据重取；session.start 装配后可用 */\r\n  99 let refreshAll: (() => void) | undefined\r\n 100 let planTimer: ReturnType<EngineInterface['clock']['every']> | undefined\r\n 101 let gitTimer: ReturnType<EngineInterface['clock']['every']> | undefined\r\n 102 \r\n 103 /** 自动侧边栏状态（官方 diff 面板范式）：本会话只自动试一次；用户手动开关过面板则不再打扰 */\r\n 104 let autoOpened = false\r\n 105 let manualDeck = false\r\n 106 /** 最近一次 AbovePrompt 绘制观测到的全屏布局状态（侧边栏可停靠的前提） */\r\n 107 let lastFullscreen = false\r\n 108 /** 自动侧边栏开关；register 时按 userConfig 覆盖 */\r\n 109 let autoOpenMode: 'on' | 'off' = 'on'\r\n 110 \r\n 111 /** 越界拦截的 deny 文案 */\r\n 112 function guardDenyMessage(hit: GuardHit): string {\r\n 113   return `${hit.tool} ${hit.path} 在批次 ${hit.batch} 边界外，已按 guardMode=deny 拦截。确需改动请先调用 flow_batch 更新边界。`\r\n 114 }\r\n 115 \r\n 116 /** 越界放行的 warn 文案 */\r\n 117 function guardWarnMessage(hit: GuardHit): string {\r\n 118   return `⚠ ${hit.tool} ${hit.path} 在批次 ${hit.batch} 边界外，已放行（guardMode=warn）`\r\n 119 }\r\n 120 \r\n 121 /** 守卫动作：pass 放行；deny/warn 附工具名、越界路径、批次与去重键 */\r\n 122 export type GuardAction =\r\n 123   | { action: 'pass' }\r\n 124   | { action: 'deny' | 'warn'; tool: string; path: string; batch: string; key: string }\r\n 125 \r\n 126 /** deny/warn 判定携带的越界信息（消息组装与去重共用） */\r\n 127 type GuardHit = Extract<GuardAction, { action: 'deny' | 'warn' }>\r\n 128 \r\n 129 /** 读取边界并作出守卫判定；未声明边界或 cwd 未就绪时放行（fail-open） */\r\n 130 async function decideGuard($: EngineInterface, tool: string, file_path: unknown): Promise<GuardAction> {\r\n 131   const scope: BatchScope | null = await read($, batchScope)\r\n 132   const task = await read($, currentTask)\r\n 133   if (scope === null || sessionCwd === '' || task?.kind !== 'implement' ||\r\n 134       task.plan !== scope.plan || (task.batch !== undefined && task.batch !== scope.batch)) return { action: 'pass' }\r\n 135   const decision = guardDecision(scope, tool, { file_path }, sessionCwd)\r\n 136   if (decision.kind === 'pass') return { action: 'pass' }\r\n 137   return { action: guardMode, tool, path: decision.path, batch: scope.batch, key: decision.key }\r\n 138 }\r\n 139 \r\n 140 /** warn 越界提醒按归一化路径去重：同批同文件（含跨 Edit/Write）只提醒一次，批次重声明时清空 */\r\n 141 async function warnOnce($: EngineInterface, hit: GuardHit): Promise<void> {\r\n 142   const seen = await read($, guardWarned)\r\n 143   if (seen.includes(hit.key)) return\r\n 144   await update($, guardWarned, prev => [...prev, hit.key].slice(-200))\r\n 145   $.ui.log(guardWarnMessage(hit))\r\n 146 }\r\n 147 \r\n 148 /** 一个方案的一行状态文案（statusline 与 toast 共用的口径） */\r\n 149 function summarize(plan: PlanReview): string {\r\n 150   const latest = plan.rounds.at(-1) ?? null\r\n 151   if (latest === null) return `「${plan.name}」评审 R${plan.round} 进行中 · 暂无评审结果`\r\n 152   const mark = plan.passed ? ' · ✓ 已达标' : ''\r\n 153   return `「${plan.name}」评审 R${plan.round}/5 · 最新 ${latest.score} 分${mark}`\r\n 154 }\r\n 155 \r\n 156 /** 一条执行上报的摘要文案（横条与 toast 共用的口径） */\r\n 157 function describeExecution(report: ExecutionReport): string {\r\n 158   const t = report.tLevel === undefined ? '' : ` · ${report.tLevel}`\r\n 159   const tests =\r\n 160     report.testsTotal === undefined ? '' : ` · 验证 ${report.testsPassed ?? 0}/${report.testsTotal}`\r\n 161   return `${report.plan} · ${report.batch}${t} · ${report.phase}${tests}`\r\n 162 }\r\n 163 \r\n 164 /** 读上次执行的跨会话记录；store 不可用或无记录时返回 null（best-effort） */\r\n 165 async function readLastExecution($: EngineInterface): Promise<ExecutionReport | null> {\r\n 166   try {\r\n 167     return parseExecution(await $.store.get(EXECUTION_STORE_KEY))\r\n 168   } catch {\r\n 169     return null\r\n 170   }\r\n 171 }\r\n 172 \r\n 173 async function readTaskView($: EngineInterface) {\r\n 174   return selectTaskView(await read($, currentTask), {\r\n 175     plans: await read($, plans),\r\n 176     report: await read($, execution),\r\n 177     scope: await read($, batchScope),\r\n 178     graph: await read($, deps),\r\n 179   })\r\n 180 }\r\n 181 \r\n 182 /** 读取文档装入浏览面板；读失败时 text 置 null 记原因，面板内提示不崩 */\r\n 183 async function loadDoc($: EngineInterface, path: string): Promise<void> {\r\n 184   let text: string | null = null\r\n 185   let error: string | undefined\r\n 186   try {\r\n 187     text = await $.fs.read(path)\r\n 188   } catch (cause) {\r\n 189     error = String(cause)\r\n 190   }\r\n 191   await update($, docFile, () => ({ path, text, ...(error === undefined ? {} : { error }) }))\r\n 192   await update($, docSection, () => 0)\r\n 193   await update($, docMode, () => 'all')\r\n 194 }\r\n 195 \r\n 196 /** 记录本会话 Edit/Write 改动路径（去重保序，cap 50）；守卫钩子放行分支调用，不阻塞链路 */\r\n 197 async function recordTouch($: EngineInterface, file_path: unknown): Promise<void> {\r\n 198   if (typeof file_path !== 'string' || file_path === '' || sessionCwd === '') return\r\n 199   const path = normalizePath(file_path, sessionCwd)\r\n 200   const key = path.toLowerCase()\r\n 201   try {\r\n 202     await update($, touched, prev => {\r\n 203       const rest = prev.filter(one => one.path.toLowerCase() !== key)\r\n 204       return [...rest, { path, at: Date.now() }].slice(-TOUCHED_CAP)\r\n 205     })\r\n 206   } catch (error) {\r\n 207     $.ui.log(`flow-deck 改动记录失败：${String(error)}`, { to: 'debug' })\r\n 208   }\r\n 209   // 自动侧边栏（官方 diff 面板范式）：agent 首次编辑时，若布局可停靠、用户未手动\r\n 210   // 开关过面板且本会话未试过，则不抢键盘焦点地打开一次\r\n 211   if (autoOpenMode === 'on' && !autoOpened && !manualDeck && lastFullscreen) {\r\n 212     autoOpened = true\r\n 213     try {\r\n 214       const isOpen = (await $.ui.panes()).some(pane => pane.id === DECK_PANE_ID)\r\n 215       if (!isOpen) {\r\n 216         const opened = await $.ui.open({ id: DECK_PANE_ID, title: DECK_TITLE, focus: false })\r\n 217         if (!opened.isPlaced) $.ui.log(`flow-deck 自动侧边栏未停靠：${opened.reason}`, { to: 'debug' })\r\n 218         void refreshAgents?.().catch(() => {})\r\n 219       }\r\n 220     } catch (error) {\r\n 341 \r\n 342   // 历史评审仅作数据来源，不据此认定当前正在迭代。\r\n 343   const lastPlan = bannerPlan(task?.kind === 'iterate' ? found.filter(plan => plan.name === task.plan) : [])\r\n 344   const summary = lastPlan === null ? undefined : summarize(lastPlan)\r\n 345   if (changed) $.ui.log(`flow-deck 扫描完成：${found.length} 个方案`, { to: 'debug' })\r\n 346   if (summary !== lastStatus) {\r\n 347     lastStatus = summary\r\n 348     $.ui.status(summary)\r\n 349   }\r\n 350 }\r\n 351 \r\n 352 const renderFlowBody = async ($: EngineInterface, e: PaneArgs) => {\r\n 353   const { Box, Text, Button } = $.ui.resolve(e)\r\n 354   const task = await read($, currentTask)\r\n 355   const { plans: list, graph, report, scope } = await readTaskView($)\r\n 356   const progressMap: Record<string, string> = await read($, progress)\r\n 357   const snapshot = await read($, agents)\r\n 358   const crumbs = await read($, lastRun)\r\n 359   const stallMinutes = await read($, stall)\r\n 360   const wide = e.props.bodyColumns >= 44\r\n 361   const nodes = graph === null ? [] : depStatuses(graph, progressMap)\r\n 362   const links = pipelineLinks(nodes)\r\n 363   const done = nodes.filter(node => node.status === 'done').length\r\n 364   const passing = list.filter(plan => plan.passed)\r\n 365   // 无事不扰：达标方案折叠为一行，未达标排前并逐个展示\r\n 366   const activePlans = [...list].sort((a, b) => Number(a.passed) - Number(b.passed)).filter(plan => !plan.passed)\r\n 367   const names = new Map(snapshot.agents.map(agent => [agent.id, agent.name || agent.description || agent.id]))\r\n 368 \r\n 369   const agentsSection = (\r\n 370     <Box flexDirection=\"column\" gap={1}>\r\n 371       <Box gap={2}>\r\n 372         <Text bold wrap=\"truncate-end\">{MARK.title}子代理{snapshot.loaded ? ` · ${agentSummary(snapshot.agents)}` : ''}</Text>\r\n 373         <Button key=\"flow-refresh\" hotkey=\"r\" plain onPress={() => refreshAll?.()}>刷新</Button>\r\n 374       </Box>\r\n 375       {snapshot.error && <Text color={TONE.warn} wrap=\"truncate-end\">刷新失败，自动重试；{snapshot.loaded ? '以下为上次快照，状态可能已过期。' : '暂未取得子代理状态。'}</Text>}\r\n 376       {!snapshot.loaded && !snapshot.error && <Text dimColor>正在读取当前会话的子代理…</Text>}\r\n 377       {snapshot.loaded && snapshot.agents.length === 0 && <Text dimColor>当前会话暂无子代理。</Text>}\r\n 378       {snapshot.agents.map(agent => {\r\n 379         const status = agentStatus(agent.status)\r\n 380         return (\r\n 381           <Box key={agent.id} flexDirection=\"column\" borderStyle={wide ? 'round' : undefined} borderColor={status.color} borderDimColor paddingX={wide ? 1 : 0} hover={{ borderDimColor: false }}>\r\n 382             <Box>\r\n 383               <Text bold color={status.color} wrap=\"truncate-end\">{status.mark} {status.label} · {agent.name || agent.description || agent.id}</Text>\r\n 384               <Button key={`agent-view-${agent.id}`} dimColor onPress={() => {\r\n 385                 void $.ui.view({ agentId: agent.id }).then(result => {\r\n 386                   if ('deny' in result && result.deny !== undefined) $.ui.toast(`无法查看子代理：${result.deny}`)\r\n 387                 }).catch(error => {\r\n 388                   $.ui.log(`flow-deck 查看子代理失败：${String(error)}`, { to: 'debug' })\r\n 389                 })\r\n 390               }}>查看</Button>\r\n 391             </Box>\r\n 392             <Text dimColor wrap=\"truncate-middle\">{agent.type} · {agent.id}</Text>\r\n 393             {agent.description !== '' && <Text wrap=\"truncate-end\">任务：{agent.description}</Text>}\r\n 394             {agent.parentId !== undefined && <Text dimColor wrap=\"truncate-middle\">↳ 父代理：{names.get(agent.parentId) ?? agent.parentId}</Text>}\r\n 395             {agent.spawnedBy !== undefined && <Text dimColor wrap=\"truncate-end\">来源插件：{agent.spawnedBy}</Text>}\r\n 396           </Box>\r\n 397         )\r\n 398       })}\r\n 399     </Box>\r\n 400   )\r\n 401 \r\n 402   if (task === null) {\r\n 403     return (\r\n 404       <Box flexDirection=\"column\" gap={1}>\r\n 405         <Box flexDirection=\"column\">\r\n 406           <Text>当前无方案迭代或实施任务。</Text>\r\n 407           <Text dimColor>运行 plan-iterate 开始方案迭代，或 implement-plan 开始实施。</Text>\r\n 408           {crumbs !== null && <Text dimColor wrap=\"truncate-end\">上次执行：{describeExecution(crumbs)}</Text>}\r\n 409         </Box>\r\n 410         {agentsSection}\r\n 411         <Text dimColor wrap=\"truncate-end\">/deck 关闭 · 面板内按 r 刷新</Text>\r\n 412       </Box>\r\n 413     )\r\n 414   }\r\n 415 \r\n 416   const phase = report === null ? null : phaseProgress(report.phase)\r\n 417   return (\r\n 418     <Box flexDirection=\"column\" gap={1}>\r\n 419       <Box flexDirection=\"column\">\r\n 420         <Button key=\"task-plan-open\" plain onPress={() => { void openPlanDoc($, task.plan) }}>\r\n 421           <Text bold color={TONE.accent} wrap=\"truncate-end\">{MARK.title}工作面板 · {task.kind === 'iterate' ? '方案迭代' : '方案实施'} · </Text>\r\n 422           <Text bold color={TONE.accent} underline wrap=\"truncate-end\">{task.plan}</Text>\r\n 423         </Button>\r\n 424         {task.kind === 'iterate' && <Text dimColor wrap=\"truncate-end\">评审 {list.length} · 待达标 {list.length - passing.length} · 已达标 {passing.length}</Text>}\r\n 425         {task.kind === 'implement' && graph !== null && <Text dimColor wrap=\"truncate-end\">批次 {done}/{nodes.length} 收口</Text>}\r\n 426       </Box>\r\n 427       {task.kind === 'iterate' && list.length === 0 && <Text dimColor>方案迭代进行中，等待评审结果落盘。</Text>}\r\n 428       {task.kind === 'implement' && report === null && <Text dimColor>实施任务已开始，等待阶段进度上报。</Text>}\r\n 429       {report !== null && phase !== null && (\r\n 430         <Box flexDirection=\"column\" borderStyle={wide ? 'round' : undefined} borderColor={TONE.accent} paddingX={wide ? 1 : 0}>\r\n 431           <Button key=\"exec-plan-open\" plain onPress={() => { void openPlanDoc($, report.plan) }}>\r\n 432             <Text bold color={TONE.accent} wrap=\"truncate-end\">{MARK.run} 当前执行 · </Text>\r\n 433             <Text bold color={TONE.accent} underline wrap=\"truncate-end\">{report.plan}</Text>\r\n 434           </Button>\r\n 435           <Text wrap=\"truncate-end\">\r\n 436             {report.batch}\r\n 437             {report.tLevel !== undefined && <Text backgroundColor={TONE.accent} color=\"inverseText\"> {report.tLevel} </Text>}\r\n 438             {' '}· {report.phase}\r\n 439           </Text>\r\n 440           {phase.total > 0 && (\r\n 441             <Text wrap=\"truncate-end\">\r\n 442               <Text color={TONE.ok}>{progressBar(phase.index, phase.total)}</Text>\r\n 443               <Text> </Text>\r\n 444               <Text color={phase.index >= phase.total ? TONE.ok : TONE.warn} bold>{phase.current} · {phase.index}/{phase.total}</Text>\r\n 445             </Text>\r\n 446           )}\r\n 447           {phase.total === 0 && <Text dimColor wrap=\"truncate-end\">{phase.current}</Text>}\r\n 448           {stallMinutes !== null && <Text color={TONE.warn} wrap=\"truncate-end\">{MARK.alert} 疑似停滞 · 距上次上报 {stallMinutes} 分钟</Text>}\r\n 449           {report.testsTotal !== undefined && (\r\n 450             <Text color={report.testsTotal > 0 && report.testsPassed === report.testsTotal ? TONE.ok : TONE.warn} wrap=\"truncate-end\">\r\n 451               验证 {progressBar(report.testsPassed ?? 0, report.testsTotal)} {report.testsPassed ?? 0}/{report.testsTotal}\r\n 452             </Text>\r\n 453           )}\r\n 454           {report.evidenceDir !== undefined && <Text dimColor wrap=\"truncate-middle\">证据 {report.evidenceDir}</Text>}\r\n 455         </Box>\r\n 456       )}\r\n 457       {scope !== null && <Text dimColor wrap=\"truncate-end\">{MARK.info} 边界 · {scope.plan} / {scope.batch} · {scope.files.length} 文件 · {guardMode}</Text>}\r\n 458       {activePlans.length > 0 && (\r\n 459         <Text bold>{MARK.title}plan-iterate 评审 · 8.5 分且无 P0/P1 达标</Text>\r\n 460       )}\r\n 461       {activePlans.map(plan => {\r\n 462         const latest = plan.rounds.at(-1) ?? null\r\n 463         const previous = plan.rounds.at(-2) ?? null\r\n 464         const delta = latest === null || previous === null ? null : latest.score - previous.score\r\n 465         const tone = plan.passed ? TONE.ok : latest !== null && latest.p0 > 0 ? TONE.bad : TONE.warn\r\n 466         return (\r\n 467           <Box key={plan.dir} flexDirection=\"column\" borderStyle={wide ? 'round' : undefined} borderColor={tone} borderDimColor paddingX={wide ? 1 : 0} hover={{ borderDimColor: false }}>\r\n 468             <Button key={`plan-open-${plan.dir}`} plain onPress={() => { void openPlanDoc($, plan.name) }}>\r\n 469               <Text bold color={tone}>{plan.passed ? MARK.done : MARK.run} </Text>\r\n 470               <Text bold color={tone} underline wrap=\"truncate-end\">{plan.name}</Text>\r\n 471             </Button>\r\n 472             <Text wrap=\"truncate-end\">\r\n 473               <Text color={tone}>{latest === null ? '等待结果' : `${latest.score.toFixed(1)} / 10`}</Text>\r\n 474               <Text dimColor> · R{plan.round}/5 · {plan.passed ? '已达标' : '待达标'}</Text>\r\n 475             </Text>\r\n 476             {latest !== null && (\r\n 477               <Text wrap=\"truncate-end\">\r\n 478                 <Text color={tone}>{scoreGauge(latest.score)}</Text>\r\n 479                 <Text dimColor> {sparkline(plan.rounds.slice(-12).map(round => round.score))}</Text>\r\n 480                 {delta !== null && <Text color={delta > 0 ? TONE.ok : delta < 0 ? TONE.bad : undefined}> {delta > 0 ? '↑' : delta < 0 ? '↓' : '='}{Math.abs(delta).toFixed(1)}</Text>}\r\n 481               </Text>\r\n 482             )}\r\n 483             <Text wrap=\"truncate-end\">\r\n 484               {latest === null && <Text dimColor>暂无已落盘的评审结果</Text>}\r\n 485               {latest !== null && latest.p0 > 0 && <Text color={TONE.bad}>P0×{latest.p0} </Text>}\r\n 486               {latest !== null && latest.p1 > 0 && <Text color={TONE.warn}>P1×{latest.p1} </Text>}\r\n 487               {latest !== null && latest.p2 > 0 && <Text dimColor>P2×{latest.p2}</Text>}\r\n 488               {latest !== null && latest.p0 === 0 && latest.p1 === 0 && latest.p2 === 0 && (\r\n 489                 <Text dimColor>无问题</Text>\r\n 490               )}\r\n 491             </Text>\r\n 492           </Box>\r\n 493         )\r\n 494       })}\r\n 495       {passing.length > 0 && <Text color={TONE.ok} wrap=\"truncate-end\">{MARK.done} 已达标 {passing.length} 个方案（已折叠）</Text>}\r\n 496       {graph !== null && (\r\n 497         <Box flexDirection=\"column\" gap={1}>\r\n 498           <Text bold wrap=\"truncate-end\">{MARK.title}执行 DAG（{graph.plan}）</Text>\r\n 499           <Text color={TONE.accent} wrap=\"truncate-end\">\r\n 500             {nodes.flatMap((node, index) => {\r\n 501               const glyph = (\r\n 502                 <Text key={node.batch}\r\n 503                   color={node.status === 'done' ? TONE.ok : node.status === 'active' ? TONE.warn : undefined}\r\n 504                   dimColor={node.status === 'pending'}>\r\n 505                   {node.status === 'done' ? MARK.nodeDone : node.status === 'active' ? MARK.nodeRun : MARK.nodeWait}\r\n 506                 </Text>\r\n 507               )\r\n 508               if (index === nodes.length - 1) return [glyph]\r\n 509               const linkStatus = links[index]\r\n 510               const link = (\r\n 511                 <Text key={`${node.batch}-link`}\r\n 512                   color={linkStatus === 'done' ? TONE.ok : linkStatus === 'active' ? TONE.warn : undefined}\r\n 513                   dimColor={linkStatus === 'pending'}>\r\n 514                   {linkStatus === 'pending' ? '╌' : '━'}\r\n 515                 </Text>\r\n 516               )\r\n 517               return [glyph, link]\r\n 518             })}\r\n 519             {' '}{done}/{nodes.length} 收口 · {nodes.filter(node => node.status === 'active').length} 进行中\r\n 520           </Text>\r\n 521           {nodes.map((node, index) => (\r\n 522             <Box key={node.batch} flexDirection=\"column\">\r\n 523               <Text dimColor={node.status === 'pending'} color={node.status === 'done' ? TONE.ok : node.status === 'active' ? TONE.warn : undefined} wrap=\"truncate-end\">\r\n 524                 {node.status === 'done' ? `${MARK.done} ` : node.status === 'active' ? `${MARK.run} ` : `${MARK.idle} `}{node.batch}\r\n 525               </Text>\r\n 526               <Text dimColor wrap=\"truncate-end\">{index === nodes.length - 1 ? '└' : '│'} {progressMap[`${graph.plan}#${node.batch}`] ?? '待执行'}{node.dependsOn.length > 0 ? ` · ← ${node.dependsOn.join('、')}` : ' · 起点'}</Text>\r\n 527             </Box>\r\n 528           ))}\r\n 529         </Box>\r\n 530       )}\r\n 531       {agentsSection}\r\n 532       <Text dimColor wrap=\"truncate-end\">/deck 关闭 · 点方案名看文档 · 面板内按 r 刷新</Text>\r\n 533     </Box>\r\n 534   )\r\n 535 }\r\n 536 \r\n 537 const renderDocBody = async ($: EngineInterface, e: PaneArgs) => {\r\n 538   const { Box, Text, Button, Select, Markdown } = $.ui.resolve(e)\r\n 539   const doc = await read($, docFile)\r\n 540   const wide = e.props.bodyColumns >= 44\r\n 541   if (doc === null) {\r\n 542     return (\r\n 543       <Box flexDirection=\"column\">\r\n 544         <Text>未打开文档。</Text>\r\n 545         <Text dimColor>用法：/doc &lt;相对路径&gt; 打开要浏览的文档。</Text>\r\n 546       </Box>\r\n 547     )\r\n 548   }\r\n 549 \r\n 550   const sendEdit = async () => {\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -NoProfile -Command \"python -X utf8 -c \\\"from pathlib import Path; files=['plugins/flow-deck/.claude-plugin/plugin.json','plugins/flow-deck/.codex-plugin/plugin.json','plugins/flow-deck/hooks/ui.ts','plans/flow-deck/2026-11-01-native-ui-redesign.md']; [print('\\\\n### '+f+'\\\\n'+Path(f).read_text(encoding='utf-8')) for f in files]\\\"\"","aggregated_output":"\r\n### plugins/flow-deck/.claude-plugin/plugin.json\r\n{\r\n  \"name\": \"flow-deck\",\r\n  \"version\": \"0.17.0\",\r\n  \"description\": \"rulertu-flow 工作流、仓库与子代理状态仪表盘：评审进度、批次守卫、依赖图、git 更改与子代理运行状态\",\r\n  \"types\": \"./types/index.d.ts\",\r\n  \"userConfig\": {\r\n    \"guardMode\": {\r\n      \"type\": \"string\",\r\n      \"title\": \"守卫模式\",\r\n      \"options\": [\"warn\", \"deny\"],\r\n      \"default\": \"warn\",\r\n      \"description\": \"越界改动处理：warn 提醒后放行，deny 硬拦截\"\r\n    },\r\n    \"autoOpen\": {\r\n      \"type\": \"string\",\r\n      \"title\": \"自动侧边栏\",\r\n      \"options\": [\"on\", \"off\"],\r\n      \"default\": \"on\",\r\n      \"description\": \"全屏布局下 agent 首次编辑文件时自动打开面板（不抢键盘焦点）；手动开关过面板后本会话不再自动开\"\r\n    }\r\n  }\r\n}\r\n\r\n\r\n### plugins/flow-deck/.codex-plugin/plugin.json\r\n{\r\n  \"name\": \"flow-deck\",\r\n  \"description\": \"rulertu-flow 工作流、仓库与子代理状态仪表盘（mod 机制仅 Claude Code 生效，Codex 侧为占位元数据）\",\r\n  \"version\": \"0.17.0\"\r\n}\r\n\r\n\r\n### plugins/flow-deck/hooks/ui.ts\r\nimport type { ThemeKey } from 'claude-code'\r\n\r\n/**\r\n * 语义色 token：全文界面颜色只经此表取值（出处：plans/flow-deck/2026-11-01-native-ui-redesign.md §设计契约）。\r\n * ThemeKey 跟随用户 /theme 与换肤类 mod 自动适配；渲染层禁用 ANSI 字面量色名。\r\n */\r\nexport const TONE = {\r\n  /** 面板标题、flow 前缀、进行中强调、chip 底色（2026-11-02 应用户要求由 claude 橙改为蓝） */\r\n  accent: 'professionalBlue',\r\n  /** 子代理区强调色：保留与 Claude Code 子代理展示一致的橙 */\r\n  agent: 'claude',\r\n  /** 完成/达标/已暂存/ahead/干净（承接旧 green） */\r\n  ok: 'success',\r\n  /** 警告/待达标/未暂存/behind/停滞（承接旧 yellow） */\r\n  warn: 'warning',\r\n  /** 失败/冲突/P0/越界（承接旧 red） */\r\n  bad: 'error',\r\n  /** git 行级新增（+N） */\r\n  added: 'diffAdded',\r\n  /** git 行级删除（−N） */\r\n  removed: 'diffRemoved',\r\n} as const satisfies Record<string, ThemeKey>\r\n\r\n/** 状态符号表：一词一义（出处同上）。面板标题、状态点、DAG 节点与连线只经此表取值。 */\r\nexport const MARK = {\r\n  /** 面板/区块标题前缀（唯一标题标记） */\r\n  title: '▍',\r\n  /** 活动中 */\r\n  run: '●',\r\n  /** 非活动：待执行/未知状态/子代理已停止 */\r\n  idle: '○',\r\n  /** 完成/达标/干净 */\r\n  done: '✓',\r\n  /** 失败/冲突 */\r\n  bad: '✗',\r\n  /** DAG 节点：收口 */\r\n  nodeDone: '■',\r\n  /** DAG 节点：进行中 */\r\n  nodeRun: '▣',\r\n  /** DAG 节点：待执行 */\r\n  nodeWait: '□',\r\n  /** 非状态信息行前缀（横条 git 行、批次边界行） */\r\n  info: '◇',\r\n  /** 预警/疑似停滞（区别于 ✗：尚未失败） */\r\n  alert: '⚠',\r\n  /** 批次边界内文件标注（/tree 面板） */\r\n  pin: '◆',\r\n} as const\r\n\r\n\r\n### plans/flow-deck/2026-11-01-native-ui-redesign.md\r\n# flow-deck 深度原生界面重构方案（主题融合 + 标志组件 + 原生控件 + 文件树面板）\r\n\r\n日期：2026-11-01 · 状态：自审修复后定稿 · 基线：worktree `flow-deck-redesign`（基点 9c6155c）\r\n验证基线命令（红线回归，仓库根运行）：`claude plugin validate plugins/flow-deck` + `claude plugin test plugins/flow-deck`\r\n锚点口径：全部 `文件:行号` 以基线 9c6155c 为准；前序批次会新增 JSX 行使后续批次锚点后移，执行时一律按内容特征重新定位，不盲用行号。\r\n\r\n## 背景与目标\r\n\r\n用户选定 C 路线（深度原生）并追加文件树融合批：不装第三方 filetree mod，文件树作为 flow-deck 自研面板，与批次守卫、git 状态同源联动。目标三条：\r\n\r\n1. **融入**：全部界面颜色从 ANSI 字面量（cyan/green/yellow/red）迁移到引擎主题语义 key，面板随用户 `/theme` 与换肤类 mod 自动适配。\r\n2. **辨识**：两个 flow-deck 独有的可视化（批次流水线条、评审达标刻度条）+ 原生控件（primary 按钮、反色 chip、hover、Markdown 渲染）。\r\n3. **痛点**：`/tree` 文件树面板——本会话改动清单置顶 + 目录懒浏览 + 批次边界标注，解决「agent 跑完后要到系统资源管理器找改动文件」。\r\n\r\n非目标：不追平第三方 filetree 的搜索/treemap/diff 视图；不做动画计时器；零新依赖；不触碰守卫判定（`guardDecision`）与轮询调度逻辑（poll.ts 语义不变）——这是本方案红线：**B1-B4 任一批次不得改变守卫放行/拦截行为与轮询节奏，只允许在既有钩子内追加渲染数据记录**。\r\n\r\n## 设计契约（单一出处）\r\n\r\n### 色彩映射\r\n\r\n全文色彩只经 `hooks/ui.ts` 的 `TONE` 常量取值（`import type { ThemeKey } from 'claude-code'`，`as const satisfies Record<string, ThemeKey>`）：\r\n\r\n| 键 | ThemeKey | 承接旧值 | 语义 |\r\n| --- | --- | --- | --- |\r\n| `accent` | `claude` | `cyan` | 面板标题、flow 前缀、进行中强调、chip 底色 |\r\n| `ok` | `success` | `green` | 完成/达标/已暂存/ahead/干净 |\r\n| `warn` | `warning` | `yellow` | 警告/待达标/未暂存/behind/停滞 |\r\n| `bad` | `error` | `red` | 失败/冲突/P0/越界 |\r\n| `added` | `diffAdded` | `green`（+行数） | 行级新增 |\r\n| `removed` | `diffRemoved` | `red`（−行数） | 行级删除 |\r\n\r\n规则：↑ahead/↓behind 用 `ok`/`warn`（分支导航语义）；+N/−N 行数用 `added`/`removed`（diff 语义）。次级文本沿用 `dimColor`；chip 文字色用 `inverseText`。23 个 ThemeKey 之外不用任何 raw color（若真机目检发现 `claude`/`diffAdded` 观感不可接受，回退方案记录于「风险与回退」）。\r\n\r\n### 符号表\r\n\r\n全文状态符号只经 `hooks/ui.ts` 的 `MARK` 常量取值，一词一义：\r\n\r\n| 符号 | 键 | 唯一语义 |\r\n| --- | --- | --- |\r\n| `▍` | `title` | 面板/区块标题前缀（唯一标题标记；`●` 不再用于标题） |\r\n| `●` | `run` | 活动中（含子代理运行中、DAG 节点 `▣` 的行内形式） |\r\n| `○` | `idle` | 非活动（待执行/未知状态/子代理已停止——agents killed 并入此键，不再单用 `■`） |\r\n| `✓` | `done` | 完成/达标/干净 |\r\n| `✗` | `bad` | 失败/冲突 |\r\n| `■` `▣` `□` | `nodeDone`/`nodeRun`/`nodeWait` | DAG 节点三态（保留现状字符） |\r\n| `▏` | `gauge` | 评审达标线刻度（scoreGauge 内固定位置，由 pass 决定，不随 score 移动） |\r\n| `╌` | `linkWait` | 流水线连线待执行段（下游 pending） |\r\n| `◆` | `pin` | 批次边界内文件标注（B4 引入） |\r\n| `↑` `↓` `←` `→` `↳` | 保留字面量 | ahead/behind/依赖/rename/父级 |\r\n\r\n面板标题改版（B1）：`FLOW / …` → `▍工作流 · …`、`DOC / …` → `▍文档 · …`、`GIT / 仓库状态` → `▍仓库 · 状态`（分支仍在标题下首行）。保留 `◇ git`、`▸` 横条前缀。agents.ts 的 killed（已停止）改用 `MARK.idle`（○），同步更新 `register.test.ts` 中 `/■ 已停止/` 断言（现状 :141 附近）为 `/○ 已停止/`。\r\n\r\n## 路线图\r\n\r\n### 优先级矩阵（价值 × 成本）\r\n\r\n| 批次 | 价值 | 成本 | 序 |\r\n| --- | --- | --- | --- |\r\n| B1 色彩与符号迁移 | 最高（全局融入根基） | 低（纯替换+断言更新） | 1 |\r\n| B2 标志性组件 | 高（辨识度） | 中（两纯函数+渲染接入） | 2 |\r\n| B3 Markdown/hover/分层 | 中高（原生质感） | 中（含真机形态探针） | 3 |\r\n| B4 文件树面板 | 高（痛点直击） | 高（新面板+新钩子数据） | 4 |\r\n\r\n### 波次依赖\r\n\r\nB1 → B2 → B3 → B4，线性。依据：后续批次都在 `register.tsx` 渲染树内工作且消费 B1 的 `TONE`/`MARK`（文件集不互斥，不并行）；B2 的状态点行与 `MARK` 符号被 B4 复用；B3 与 B4 相互独立但共享收口真机目检，线性摊薄装载开销。B2 与 B3 在 doc 面板返回块内物理相邻（B2 改 :762 按钮，B3 主战场 :743-:760），线性顺序天然消解交叠。\r\n\r\n## 详案\r\n\r\n### B1 主题语义色迁移与符号统一（T1）\r\n\r\n**如何改**：\r\n\r\n1. 新建 `plugins/flow-deck/hooks/ui.ts`：按「设计契约」导出 `TONE`、`MARK` 两常量（含 ThemeKey 类型标注与一行注释说明来源本方案 §设计契约）。\r\n2. `hooks/agents.ts:5-13`：`agentStatus` 返回色名 `'cyan'|'green'|'red'|'yellow'` → `TONE.accent|TONE.ok|TONE.bad|TONE.warn`，返回类型 `color?: string` 收窄为 `ThemeKey`；`mark` 字段改引 `MARK`，killed（已停止）由 `■` 改 `MARK.idle`（○，见符号表）；同步更新 `register.test.ts` 的 `/■ 已停止/` 断言。\r\n3. `hooks/register.tsx` 逐点替换（色值字面量 → `TONE.*`；状态点字面量 → `MARK.*`）：\r\n   - :550 刷新失败行 `color=\"yellow\"` → `TONE.warn`；\r\n   - :556-561 子代理卡 `borderColor={status.color}`（随 agents.ts 生效）、状态点 `status.mark`；\r\n   - :586 面板标题 `color=\"cyan\"` + 文案 `FLOW / …` → `TONE.accent` + `▍工作流 · …`；\r\n   - :592-612 执行卡：`borderColor=\"cyan\"`/标题 :594/进度 :598-:600/停滞 :604/验证 :606 → accent/ok/warn 映射；\r\n   - :615 评审区标题、:621 `tone`（green/red/yellow → ok/bad/warn）、:624 状态点、:633 delta ↑↓ 色（green/red → ok/bad）、:638-:640 P0/P1/P2 色、:648 达标折叠行；\r\n   - :649-671 DAG：总览行 :652 `cyan` → `TONE.accent`，:653-:659 与 :662-:669 三态色（green/yellow → ok/warn）、状态点/节点字符引 `MARK`；\r\n   - :678-768 doc 面板：:715/:716 读取失败标题与正文（red → bad）、:727/:744 标题（cyan → accent）+ 文案 `DOC / …` → `▍文档 · …`；\r\n   - :770-861 git 面板：:785 标题改版、:789-:790 ↑↓（green/yellow → ok/warn）、:793-:796 行数（green/red → **`TONE.added`/`TONE.removed`**）、:800 干净行、:801-:845 冲突/暂存/未暂存分区（red/green/yellow → bad/ok/warn）、分区标题前缀统一 `MARK.title`；\r\n   - :863-905 横条：:880 `● flow`（cyan → accent，● 引 `MARK.run`）、:892 `◇ git` 色、:893-:900 冲突/↑↓/行数色（行数同样走 added/removed）。\r\n4. `hooks/register.test.ts`：:495 `props.color === 'green'` → `'success'`、:497 `'yellow'` → `'warning'`；标题文案断言若命中旧 `FLOW /`、`DOC /` 字样同步更新（全文 grep 确认）。\r\n\r\n**如何验证**：L1 既有全套（红线回归命令）+ `tsc -p plugins/flow-deck` 类型检查（ThemeKey 收窄是否成立）+ 改动 diff 逐行机械审查（只允许色值/符号/标题文案三类替换，不得出现逻辑改动）。\r\n\r\n**验收标准**：\r\n- 给 `claude plugin test plugins/flow-deck` → 全部通过（含更新后的颜色断言与 `/○ 已停止/` 断言）。\r\n- 给 `grep -nE \"['\\\"](cyan|green|yellow|red)['\\\"]\" plugins/flow-deck/hooks/register.tsx plugins/flow-deck/hooks/agents.ts` → 0 命中（渲染层无 ANSI 字面量残留，单双引号均计；`ui.ts` 常量定义除外）。\r\n- 给/不给守卫输入 → `guardDecision` 相关测试结果与基线完全一致（红线）。\r\n\r\n**代码评审节点**：`ui.ts` 是否零逻辑纯常量；agents.ts 返回类型收窄后 `register.tsx:556` `borderColor` 接受 ThemeKey；标题改版是否漏改横条/面板文案一致性。\r\n\r\n**分级与验证流程**：T1（界面调整、加法式替换、不邻近契约、有全套测试覆盖）→ 主控亲自机械验证收口，无审计代理。\r\n\r\n### B2 标志性可视化组件（T2）\r\n\r\n**如何改**：\r\n\r\n1. `hooks/parse.ts` 新增两个纯函数：\r\n   - `scoreGauge(score: number, width = 10, pass = PASS_SCORE): string`——十格 `━/─` 条，`▏` 为**固定达标线刻度**：位置恒为 `Math.round(clamp(pass/10) * width)`（0 基插入索引，clamp 到 `0..width`），由 `pass` 决定、不随 score 移动；实格数 `Math.round(clamp(score/10) * width)` 照旧。示例（width 10、pass 8.5、passAt=9）：score 6.8 → `━━━━━━━──▏─`（7 实 2 虚 + 刻度 + 1 虚）、score 8.5 → `━━━━━━━━━▏─`（刻度恰在实虚交界）、score 0 → `─────────▏─`、score 10 → `━━━━━━━━━▏━`、pass=10 → 刻度在串尾 `━…━▏`。\r\n   - `pipelineLinks(nodes: readonly DepNode[]): readonly DepNodeStatus[]`——返回节点间连线状态序列（长度 `max(nodes.length - 1, 0)`），**连线状态 = 右侧节点状态**（流向由下游决定）：右侧 done/active 渲染 `━`（色随该节点 ok/warn），右侧 pending 渲染 `╌`（`dimColor`）。\r\n2. `hooks/register.tsx` 渲染接入：\r\n   - :631 评审卡评分行：`progressBar(latest.score, 10)` → `scoreGauge(latest.score)`（sparkline、delta 保持）；\r\n   - :652-:661 DAG 总览行：节点字符与 `pipelineLinks` 连线交错渲染——节点 `■/▣/□` 沿用现有三态色；连线段 `━`（done/active 端，色随邻接节点取 ok/warn）或 `╌`（纯 pending，`dimColor`）；行尾统计文案保持 `N/M 收口`；\r\n   - :595 执行卡 T 级渲染 chip 化：`tLevel` 存在时画 `<Text backgroundColor={TONE.accent} color=\"inverseText\"> {tLevel} </Text>`，批号 `B2` 保持普通文本；\r\n   - :762 doc 面板「发给 Claude」按钮加 `variant=\"primary\"`；:548 面板刷新按钮保持 `plain`（次要操作，不升级）。\r\n3. `hooks/parse.test.ts` 新增 L1 用例：scoreGauge（0/10、6.8、8.5 恰在刻度、10 满格、越界 clamp、pass=10）；pipelineLinks（单节点空数组、全 pending、done-active、active-pending、两 active）。\r\n4. `hooks/register.test.ts`：DAG 总览行断言适配连线字符（:494-:500 findAll `■/▣/□` 颜色断言结构不变，应继续通过；若连线改变聚合文本匹配，按 `findAll({ type, text })` 粒度修正）；新增评审卡含 `▏` 断言。\r\n\r\n**如何验证**：L1（parse.test 新用例）+ L2 渲染树（register.test：评审卡 `▏` 存在、DAG 行连线存在、chip 存在且 `props.backgroundColor === 'claude'`）+ 红线回归。\r\n\r\n**验收标准**：\r\n- 给 score 6.8 → `scoreGauge` 输出 `━━━━━━━──▏─`；给 score 0 → `─────────▏─`（刻度固定在 passAt 位置）；给 score 8.5 → `━━━━━━━━━▏─`；给 score 12 → 满格 `━━━━━━━━━▏━` 无越界字符；给 pass=10 → 刻度在串尾。\r\n- 给 3 节点 [done, active, pending] → 总览行文本含 `■━▣╌□` 顺序字符（active→pending 段为 `╌`），各段颜色符合映射（连线段 dimColor）。\r\n- 给 flow_report tLevel=T1 → 渲染树存在 `backgroundColor === 'claude'` 且文本含 `T1` 的 Text；不给 tLevel → 无该 Text。\r\n- 红线回归全绿。\r\n\r\n**代码评审节点**：`▏` 插入不改变 sparkline/delta 对齐；连线状态取右规则的实现与用例一致；chip 不出现在横条（横条空间窄，chip 只在面板内）。\r\n\r\n**分级与验证流程**：T2（多文件、新增渲染逻辑与纯函数、邻近 UI 渲染契约但不改契约、有既有测试模式可循）→ 审计代理（证据包模式）。\r\n\r\n### B3 /doc Markdown 渲染与 hover 增强（T2，含形态探针）\r\n\r\n**如何改**：\r\n\r\n1. `hooks/register.tsx:743-:760` doc 节内容块：区块标题行（现状 :754 为 `#` 前缀文本）改为 `MARK.title` 前缀（`▍<节标题> · 第 a–b 行` + 截断提示），正文 `shown.map(...)` 逐行 Text 替换为 `<Markdown key=\"doc-body\" text={shown.join('\\n')} />`；`DOC_SECTION_MAX_LINES` 截断逻辑保持在文本层（parse.ts 不动）。\r\n2. hover 分层降噪：:556 子代理卡与 :623 评审卡 Box 加 `borderDimColor`（常态 dim 边框），并加 `hover={{ borderDimColor: false }}`（指针悬停提亮；`BoxHoverProps` 支持 borderDimColor 覆盖）；:593 执行卡保持常态亮边框不加 hover（关键卡常亮）。\r\n3. `hooks/register.test.ts`：新增 doc 面板两 surface 循环用例（仿 :120/:330 既有循环模式）断言 `find({ type: 'Markdown' })`（text 含节内容首行）；hover 仅断言树通过（悬停行为属真机目检）。\r\n\r\n**如何验证**：L2 渲染树（两 surface）+ 红线回归 + **真机形态探针**：`claude --plugin-dir plugins/flow-deck` 打开 /doc 与 /flow，确认 Markdown 标题/列表/代码块渲染正常、长节截断生效、悬停提亮可见（全屏终端）；探针结果回写本节（通过/问题记录）。\r\n\r\n**验收标准**：\r\n- 给含 fenced code 的文档节 → 渲染树含 `type: 'Markdown'` 且 text 首行等于节内容首行；节超 60 行 → text 内行数 ≤ 60。\r\n- 给两 surface（terminal/desktop）→ 渲染树均通过引擎校验（mount 不报拒绝）。\r\n- 红线回归全绿；真机探针通过后才允许本批收口。\r\n\r\n**代码评审节点**：Markdown 不进横条与问题对话框路径；hover 对象必须已带 `key` 的 Box；截断提示文案随 Markdown 化是否仍准确（行数口径一致）。\r\n\r\n**分级与验证流程**：T2（Markdown 元素首次引入、行为依赖引擎渲染，需探针验证）→ 审计代理（证据包）+ 主控真机探针。独立收口理由：探针批——Markdown 渲染行为未经验证，失败回退不得波及 B2 组件。\r\n\r\n### B4 文件树面板（T2）\r\n\r\n**如何改**：\r\n\r\n1. `types/index.d.ts` 契约追加（不改既有字段）：`treeDir: string | null`（当前浏览目录，null=cwd 根）、`treeEntries: { entries: FsEntryLike[]; loaded: boolean } | null`、`touched: { path: string; at: number }[]`（本会话 Edit/Write 记录，去重保序，上限 50）。`FsEntryLike = { name: string; kind: string; isLink: boolean }` 与 `$.fs.list` 应答字段一致。\r\n2. `hooks/register.tsx`：\r\n   - 新 atom 三枚（:43-:59 区追加）；\r\n   - `hooks/parse.ts` 或 ui.ts 不新增数据函数；目录排序纯函数 `sortEntries(entries)`（目录在前、字典序）放 parse.ts 供 L1；\r\n   - :513-:526 既有 Edit/Write 守卫钩子：两处 `return next(e)`（pass 放行与 warn 放行）之前统一追加记录 `recordTouch($, e.file_path)`——warn 模式下越界放行的改动同样发生，必须记录；deny 分支（未发生改动）不记录；去重（大小写折叠，与守卫 key 同口径）更新 `touched`，cap 50。判定逻辑、分支顺序、返回值零改动。实现口径：采用 `await`（方案初稿为 `void`）——写完成才放行，换来测试断言确定性；recordTouch 内部 try/catch 兜底，守卫放行/拦截语义不变（波次审计 5 复核确认）；\r\n   - `session.start`（:233-:385）注册 `/tree` 命令 + treeTimer 不需要（复用既有 2 秒 planTimer？否——目录列表仅在面板打开时懒加载，打开即 list 一次、切换目录时再 list，无轮询）；\r\n   - 新 `ui.render` Pane 钩子（id `flow-tree`，标题「文件」）：\r\n     - 标题行 `▍文件 · <treeDir ?? cwd 尾段>`；\r\n     - 区块 `▍本会话改动`：touched 列表，每行 `✓/● 路径` + git 状态标注（与 `gitStatus` 文件集匹配，色沿 git 面板口径：暂存 ok/未暂存 warn/未跟踪 dim/冲突 bad）+ 批次边界内标注 `◆ · 本批`（与 `batchScope.files` 匹配）；空态「本会话尚无文件改动」；\r\n     - 区块 `▍目录`：`sortEntries(treeEntries)` 列表——目录行 `名/`、文件行 `名 + git 状态标注`（git 码与色沿 git 面板口径），目录行 Button plain 热键（1-9，超 9 个用 Select 下拉选目录）；`r` 热键重载当前目录；\r\n     - 底部提示行。\r\n3. `hooks/register.test.ts`：经 `$.tool.call` 触发 Edit 记录 touched（测试引擎写状态的工具链路口径，mock `$.fs.list` 遵循 FsEntry `isLink` 必填与路径相对解析既往坑）；渲染断言：改动区含已记录路径、边界标注 `◆`、空态文案、目录排序。\r\n4. `README.md`（插件）：`/tree` 条目与轮询开销表补一行（打开时读取，无轮询）；双 manifest（`.claude-plugin/plugin.json`、`.codex-plugin/plugin.json`）版本 0.9.0 → 0.10.0；根 `CHANGELOG.md` Unreleased 补条目（三处同步，0.9.0 漏更教训）。\r\n\r\n**如何验证**：L1（sortEntries）+ L2 渲染树（touched/边界/空态）+ 红线回归 + 真机目检（/tree 打开、进入子目录、批次边界声明后标注出现）。\r\n\r\n**验收标准**：\r\n- 给 `$.tool.call` 一次 Edit（路径 P）→ 渲染树「本会话改动」含 P；重复同路径 → 单条；第 51 条 → 挤出最旧。\r\n- 给 batchScope 含当前目录文件 F → F 行含 `◆ · 本批`；不给 → 无标注。\r\n- 给含子目录与文件的 entries → 目录在前字典序；目录热键/Select 进入 → treeEntries 更新为新目录内容。\r\n- `/tree` 已开再调 → 关闭（toggle 口径同 /git）；红线回归全绿。\r\n\r\n**代码评审节点**：recordTouch 不阻塞 next（void + 内部 catch）；touched 去重键与守卫 key 口径一致（归一化路径）；`$.fs.list()` 无参调用（空串坑）；面板关闭不残留定时器（本面板无定时器，确认无遗漏）。\r\n\r\n**分级与验证流程**：T2（新面板、新契约字段、新钩子数据流、有既往测试模式可循）。定级裁决：本批虽邻近守卫链路并在守卫钩子内追加副作用，但属红线明文授权的「既有钩子内追加渲染数据记录」（加法式、判定/分支顺序/返回值零改动、fail 路径不触及），故定 T2 不升 T3。→ 审计代理（证据包）+ 主控真机目检。\r\n\r\n### B5 统一命令 /deck 与面板页签化（T2，用户测试后追加）\r\n\r\n背景：用户测试 0.10.0 后提出——/git 与 /tree 信息重叠应合并；命令 5 个太多应统一。裁决：`/deck` 单命令 + 单面板三页签（工作流/文件/文档），git 信息以「统一改动清单」并入文件页签。\r\n\r\n**如何改**：\r\n\r\n1. `hooks/parse.ts` 新纯函数：`collectChanges(git, touched): ChangeRow[]`——git 四组文件 ∪ 本会话 touched 去重合并，每行 `{ path, touched, state }`（state ∈ conflict/staged/unstaged/untracked/null）；排序：touched 组在前、冲突优先、路径字典序。L1 用例覆盖并集去重、来源判定、排序与 git 为 null 退化为 touched 清单。\r\n2. `types/index.d.ts` 契约追加：`activeTab: 'flow' | 'files' | 'doc'`。\r\n3. `hooks/register.tsx`：\r\n   - 单一 `DECK_PANE_ID = 'deck'`；`activeTab` atom（默认 'flow'）；旧 PANE_ID/GIT_PANE_ID/TREE_PANE_ID/DOC_PANE_ID 退役。\r\n   - 命令收敛：仅注册 `deck`（description 含三页签用法）；`/deck` 无参 toggle（activeTab 保持）；`flow`/`tree`/`doc [路径]` 参数切页签（tree 映射 files 页签），doc 带路径先 loadDoc。旧 /flow /git /flow-agents /doc /tree 命令注册与钩子全部移除。\r\n   - 单一 ui.render Pane 钩子（requestId 'deck'）：顶部页签行（三枚 Button，plain + hotkey 1/2/3，当前页亮、其余 dimColor）+ 按 activeTab 分支渲染——工作流页签（原 /flow 渲染树迁移）、文件页签（git 头行 + 统一改动清单 `▍改动`（● 本会话 / ○ 其他，◆ 本批）+ 目录浏览区迁移）、文档页签（原 /doc 渲染树迁移，含空态与错误态）。`$.ui.open({ focus: true })` 使面板持焦，数字热键直切页签；holdToasts 不开。\r\n4. `hooks/register.test.ts`：全部 Pane mount 的 requestId 改 'deck' 并经 `$.ui.press`（key tab-flow/tab-files/tab-doc）切页签后再断言原内容；新增用例——统一改动清单（git ∪ touched 并集去重、● ○ 来源点、◆ 边界、git null 退化）、页签切换保持各页内容、/deck 参数分流（flow/tree/doc 直达、doc 带路径装载）、旧命令不再注册（session.start 后 command.register 捕获清单恰为 flow_task/flow_report/flow_batch/flow_deps 工具与 deck 命令）。\r\n5. `README.md` 命令节重写（/deck 用法与页签说明、/tree /git 并入说明）；双 manifest 0.10.0 → 0.11.0；根 CHANGELOG 补条目。\r\n\r\n**如何验证**：L1（collectChanges）+ L2（页签切换后各页渲染树、统一清单断言、参数分流）+ 红线回归 + 真机目检（/deck 打开、1/2/3 切页签、Esc 回输入框、/deck doc 直达）。\r\n\r\n**验收标准**：\r\n- 给 git 有 2 文件改动且 touched 含其中 1 个 + 另 1 个会话路径 → `▍改动` 恰 3 行：会话 2 行 ●、git 独有 1 行 ○；touched 独有行无 git 状态标注。\r\n- 给 git null → 改动清单退化为 touched 全集（全 ●）。\r\n- 给 flow_batch 边界含清单文件 → 该行 `◆ 本批`。\r\n- `/deck` 无参已开再调 → 关闭；`/deck doc plans/x.md` → doc 页签且文档装载。\r\n- 会话内只注册 deck 一个命令；红线回归全绿。\r\n\r\n**代码评审节点**：三个页签渲染分支迁移后 hotkey 不冲突（1/2/3 页签、r 刷新、e 发给 Claude）；plain Button 不与 variant 混用（选中态用亮暗对比实现）；collectChanges 去重键与守卫 key 口径一致（normalizePath + toLowerCase）；open({ focus: true }) 不带 holdToasts。\r\n\r\n**分级与验证流程**：T2（多文件、面板结构重构、不改契约既有字段语义、测试迁移面广但有既有模式可循）→ 审计代理（证据包）+ 主控真机目检。\r\n\r\n### B6 视线常驻空间：自动侧边栏、Spinner 进度、工具行批次标注（T2）\r\n\r\n背景：用户测试后要求「参考官方 mod 充分利用空间，体验第一」。官方 diff mod 的自动开栏范式（首次成功编辑自动开、仅可停靠布局、用户关过则不再打扰、数据先就位）与本插件守卫语义契合，照抄。\r\n\r\n**如何改**：\r\n\r\n1. 自动侧边栏：`session.start` 重置 `autoOpened`/`deckTouched` 模块标记；`recordTouch` 首次成功记录时——若 `userConfig.autoOpen !== 'off'`、本会话无人在场标记（`manual` atom：用户曾开或关过 deck 则不再自动开）、AbovePrompt 钩子缓存的 `viewport.isFullscreen === true`——`$.ui.open({ id: DECK_PANE_ID, title, focus: false })`（自动开不抢键盘，与手动开的 focus: true 区分）。本会话只试一次。manifest userConfig 追加 `autoOpen`（title 自动侧边栏，options on/off，默认 on）。\r\n2. Spinner 进度：新 `ui.render { component: 'Spinner' }` 钩子——实施中（currentTask=implement 且 execution 非收口）重写 `word` 为 `B2 · 验证 8/12`；迭代中显示 `评审 R{n} · {score} 分`；有 running 子代理且无任务时显示 `↻ {name} · {description 截断}`（多个时 `{n} 个子代理运行中`）；其余 `next(e)` 透传。desktop 表面 `message` 同步（props 相同）。\r\n3. 工具行批次标注：新 `ui.render { component: 'ToolUse' }` 钩子（matcher 无法按 props.tool 收窄 input 路径，钩子内 `e.props.tool` 分流 Edit/Write）——`isExpanded === true` 或非 Edit/Write 或 isErrored/isInterrupted 时 `next(e)` 透传；紧凑行自绘：状态图标（Edit/Write 各自引擎色）+ 工具名 + 路径（input.file_path）+ 批次标注——界内 `◆`（accent）、越界 warn 放行 `⚠ 越界`（warning）、deny 拦截 `✗ 拦截`（bad）、无任务时无标注。判定复用 `guardDecision`（守卫口径单一出处），纯展示不改写 input。\r\n4. `register.test.ts`：Spinner 三态（实施词/迭代词/子代理词/透传）、工具行三态标注 + isExpanded 透传 + 非 Edit/Write 透传、自动侧边栏（autoOpen off 不开、非 fullscreen 不开、手动开过后不开、首次编辑开一次）。\r\n\r\n**如何验证**：L2 渲染树（Spinner/ToolUse mount）+ 红线回归 + 真机目检（全屏终端 agent 编辑时侧边栏自动出现、spinner 词变化、工具行标注）。\r\n\r\n**验收标准**：\r\n- 给 autoOpen=off → 任何编辑不自动开；给非全屏 → 不开；给用户手动开/关过 → 不开；给首次编辑且全屏 → 恰开一次。\r\n- 给实施 report（B2 验证 8/12）→ Spinner 词含 `B2` 与 `8/12`；给无任务多子代理 → 词含 `个子代理运行中`；给空闲无子代理 → next(e) 透传（词不变）。\r\n- 给界内 Edit → 工具行含 `◆`；给越界 warn → 含 `⚠ 越界`；给 isExpanded → 树为引擎原行（透传）。\r\n- 红线回归全绿。\r\n\r\n**代码评审节点**：自动开不抢焦点（focus: false）；Spinner 重写不碰 `suffix`/`message`（引擎继续画时长与 token）；工具行自绘行在 ctrl+o 下让位（isExpanded 透传）；manual 标记在手动 open/close 两处设置。\r\n\r\n**分级与验证流程**：T2（新站点 hook ×2、自动开栏状态机、邻近渲染契约但不改契约）→ 审计代理（证据包）+ 主控真机目检。\r\n\r\n### B7 交互深度：输入框守卫预览、子代理查看、完成通知行（T2）\r\n\r\n**如何改**：\r\n\r\n1. 输入框守卫预览：新 `prompt.edit` 钩子（origin composer）——实施中有 batchScope 时读草稿，提取路径样式 token（`/[A-Za-z0-9_.\\-\\\\\\/]+\\.[A-Za-z]{1,6}/g`），逐 token 按守卫口径（normalizePath+toLowerCase 对 scopeSet）判定：界内 `color: TONE.ok`、越界 `color: TONE.warn`，`$.prompt.paint({ text, decorations })`；无任务或无路径 token 时 paint 空清单清除。paint 失败静默（debug log）。\r\n2. 子代理查看：面板子代理行（工作流页签）追加 plain Button `查看`（key `agent-view-{id}`）→ `$.ui.view({ agentId })`；resolve `{ deny }` 时 `$.ui.toast` 说明原因；面板页签行尾部追加「主对话」Button（key `view-main`）→ `$.ui.view({})`。\r\n3. 完成通知行：新 `ui.render { component: 'UserMessage' }` 钩子，matcher `props.origin.kind: 'task-notification'`——`next(e)` 透传 `isExpanded`；紧凑行自绘：状态点（completed ✓ ok / failed ✗ bad / 其余 ○ idle）+ 任务名（from.name 或 task.id）+ 耗时（durationMs 人读格式）。\r\n4. `register.test.ts`：paint 判定（界内 ok/越界 warn/无任务清除）、查看按钮 press → $.ui.view 调用与 deny toast、通知行三态 + isExpanded 透传。\r\n\r\n**如何验证**：L2（paint 参数捕获、view 调用捕获、通知行渲染树）+ 红线回归 + 真机目检（输入路径实时变色、点查看切子代理视图、Esc 回主对话、通知行样式）。\r\n\r\n**验收标准**：\r\n- 给实施边界含 `src/a.ts`、草稿含 `src/a.ts` 与 `docs/b.md` → paint 收到两个 decoration：前者 success 后者 warning；给 idle → paint 收到空清单。\r\n- 给 running agent 行按查看 → `$.ui.view` 收到该 agentId；给 deny 应答 → toast 含原因；按主对话 → view 收到 `{}`。\r\n- 给 task-notification（completed, 3.2s）→ 通知行含 ✓、名称与 `3.2s`；isExpanded → 透传。\r\n- 红线回归全绿。\r\n\r\n**代码评审节点**：paint 仅在 composer origin（子代理转录不碰）；路径正则保守（含扩展名 token 才判定）；view 的 person-initiated 语义（仅 Button 触发）；通知行 isExpanded 让位 ctrl+o。\r\n\r\n**分级与验证流程**：T2（prompt.edit/paint 首次引入、新站点 hook ×2）→ 审计代理（证据包）+ 主控真机目检。\r\n\r\n## 收口与真机目检\r\n\r\n四批各自收口后，末波统一目检清单（Claude Code 真机，`/theme` 深浅两档各一遍）：\r\n\r\n1. `/flow`：标题/评审卡/执行卡/DAG/子代理区块颜色随主题；流水线条与达标刻度可见；chip 反色清晰。\r\n2. `/doc`：Markdown 渲染标题/列表/代码块；截断提示准确；primary 按钮为 accent 色。\r\n3. `/git`：+N/−N 行数呈 diff 色；四分区色随主题。\r\n4. `/tree`：改动区即时反映会话内 Edit；边界标注出现；子目录导航可用。\r\n5. 横条：单行/双行空间下优先级不变；窄终端（<44 列）无布局破坏。\r\n\r\n收尾（主控 T0 直做）：CHANGELOG 条目已随 B4 落盘，确认双 manifest 版本一致后按 `rulertu-flow:commit` 起草提交。\r\n\r\n## 风险与回退\r\n\r\n- `claude`/`diffAdded`/`diffRemoved` 主题 key 在个别主题观感不佳 → 目检记录实际观感，仅该用途回退到 `TONE.ok`/`TONE.bad`（改动局限 ui.ts 单点 + 对应行）。\r\n- Markdown 元素在窄面板换行异常或与截断口径冲突 → 回退该节内容为 B3 前的逐行 Text（独立回退，不影响其他批）。\r\n- hover 在非全屏终端无效果 → 设计即为渐进增强，无功能依赖。\r\n- `▏` 刻度在等宽字体外的对齐风险 → 终端场景为等宽，风险仅限非等宽导出，接受。\r\n- touched 记录在高频 Edit 下写放大 → cap 50 + 去重已限流；`相同快照不重复写状态` 口径沿用。\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -NoProfile -Command \"python -X utf8 -c \\\"from pathlib import Path; files=['plugins/flow-deck/hooks/parse.ts','plugins/flow-deck/hooks/poll.ts','plugins/flow-deck/types/index.d.ts']; ranges=[[(250,310),(460,590)],[(1,230)],[(1,220)]]; [print('\\\\n### '+f+'\\\\n'+'\\\\n'.join(f'{i+1:4} {x}' for i,x in enumerate(Path(f).read_text(encoding='utf-8').splitlines()) if any(a<=i+1<=b for a,b in rs))) for f,rs in zip(files,ranges)]\\\"\"","aggregated_output":"\r\n### plugins/flow-deck/hooks/parse.ts\r\n 250 \r\n 251 /** 解析 state.json 文本；坏 JSON 或结构不符（含数组）返回 null */\r\n 252 export function parseStateJson(text: string): PlanState | null {\r\n 253   let data: unknown\r\n 254   try {\r\n 255     data = JSON.parse(text)\r\n 256   } catch {\r\n 257     return null\r\n 258   }\r\n 259   if (typeof data !== 'object' || data === null || Array.isArray(data)) return null\r\n 260   const record = data as { backend?: unknown; round?: unknown; plan_path?: unknown }\r\n 261   const state: PlanState = {}\r\n 262   if (typeof record.backend === 'string') state.backend = record.backend\r\n 263   if (typeof record.round === 'number') state.round = record.round\r\n 264   if (typeof record.plan_path === 'string' && record.plan_path !== '') state.planPath = record.plan_path\r\n 265   return state\r\n 266 }\r\n 267 \r\n 268 /** 评分趋势条：每轮一个字符，0-10 分映射到 ▁-█ */\r\n 269 export function sparkline(scores: readonly number[]): string {\r\n 270   return scores\r\n 271     .map(score => BLOCKS[Math.max(0, Math.min(7, Math.round((score / 10) * 7)))])\r\n 272     .join('')\r\n 273 }\r\n 274 \r\n 275 /** 校验并归一化 flow_report 上报（来自模型工具入参或 $.store 旧值），不符返回 null */\r\n 276 export function parseExecution(value: unknown): ExecutionReport | null {\r\n 277   if (typeof value !== 'object' || value === null || Array.isArray(value)) return null\r\n 278   const record = value as Record<string, unknown>\r\n 279   if (typeof record.plan !== 'string' || record.plan === '') return null\r\n 280   if (typeof record.batch !== 'string' || record.batch === '') return null\r\n 281   if (typeof record.phase !== 'string' || record.phase === '') return null\r\n 282   const report: ExecutionReport = {\r\n 283     plan: record.plan,\r\n 284     batch: record.batch,\r\n 285     phase: record.phase,\r\n 286     updatedAt: typeof record.updatedAt === 'number' ? record.updatedAt : 0,\r\n 287   }\r\n 288   if (typeof record.tLevel === 'string') report.tLevel = record.tLevel\r\n 289   if (typeof record.testsPassed === 'number') report.testsPassed = record.testsPassed\r\n 290   if (typeof record.testsTotal === 'number') report.testsTotal = record.testsTotal\r\n 291   if (typeof record.evidenceDir === 'string') report.evidenceDir = record.evidenceDir\r\n 292   return report\r\n 293 }\r\n 294 \r\n 295 /** 校验并归一化 flow_batch 边界声明，不符返回 null */\r\n 296 export function parseBatchScope(value: unknown): BatchScope | null {\r\n 297   if (typeof value !== 'object' || value === null || Array.isArray(value)) return null\r\n 298   const record = value as Record<string, unknown>\r\n 299   if (typeof record.plan !== 'string' || record.plan === '') return null\r\n 300   if (typeof record.batch !== 'string' || record.batch === '') return null\r\n 301   if (!Array.isArray(record.files)) return null\r\n 302   const files = record.files.filter((file): file is string => typeof file === 'string' && file !== '')\r\n 303   return { plan: record.plan, batch: record.batch, files }\r\n 304 }\r\n 305 \r\n 306 /** 路径归一化：反斜杠转正斜杠；绝对路径剥掉工作目录前缀（大小写不敏感比较） */\r\n 307 export function normalizePath(path: string, cwd: string): string {\r\n 308   const unified = path.replace(/\\\\/g, '/')\r\n 309   const cwdUnified = cwd.replace(/\\\\/g, '/').replace(/\\/+$/, '')\r\n 310   if (cwdUnified !== '' && unified.toLowerCase().startsWith(`${cwdUnified.toLowerCase()}/`)) {\r\n 460     }\r\n 461   }\r\n 462 \r\n 463   const files: PorcelainFile[] = []\r\n 464   for (const line of stdout.split('\\n')) {\r\n 465     if (line === '' || line.startsWith('## ')) continue\r\n 466     const code = line.slice(0, 2)\r\n 467     const rest = line.slice(3)\r\n 468     if (rest === '') continue\r\n 469     const arrow = rest.indexOf(' -> ')\r\n 470     if (arrow !== -1) {\r\n 471       files.push({\r\n 472         code,\r\n 473         path: unquotePath(rest.slice(arrow + 4)),\r\n 474         oldPath: unquotePath(rest.slice(0, arrow)),\r\n 475       })\r\n 476     } else {\r\n 477       files.push({ code, path: unquotePath(rest) })\r\n 478     }\r\n 479   }\r\n 480   return { branch, upstream, ahead, behind, files }\r\n 481 }\r\n 482 \r\n 483 /** 解析 git diff --numstat 的 stdout，累加行级增删；二进制行（-\\t-）与非法行跳过 */\r\n 484 export function parseNumstat(stdout: string): { added: number; removed: number } {\r\n 485   let added = 0\r\n 486   let removed = 0\r\n 487   for (const line of stdout.split('\\n')) {\r\n 488     const parts = line.split('\\t')\r\n 489     if (parts.length < 3) continue\r\n 490     const lineAdded = Number(parts[0])\r\n 491     const lineRemoved = Number(parts[1])\r\n 492     if (!Number.isNaN(lineAdded)) added += lineAdded\r\n 493     if (!Number.isNaN(lineRemoved)) removed += lineRemoved\r\n 494   }\r\n 495   return { added, removed }\r\n 496 }\r\n 497 \r\n 498 /** 组装 git 状态快照：XY 码分类 + 两次 numstat 合计行级增删 */\r\n 499 export function buildGitStatus(\r\n 500   porcelain: PorcelainStatus,\r\n 501   worktreeNumstat: { added: number; removed: number },\r\n 502   cachedNumstat: { added: number; removed: number },\r\n 503   fetchedAt: number,\r\n 504 ): GitStatus {\r\n 505   const staged: GitFileState[] = []\r\n 506   const unstaged: GitFileState[] = []\r\n 507   const untracked: GitFileState[] = []\r\n 508   const conflicts: GitFileState[] = []\r\n 509   for (const file of porcelain.files) {\r\n 510     if (CONFLICT_CODES.has(file.code)) {\r\n 511       conflicts.push(file)\r\n 512     } else if (file.code === '??') {\r\n 513       untracked.push(file)\r\n 514     } else {\r\n 515       // charAt 越界返回空串，includes('') 为 false，免于索引 undefined\r\n 516       if ('MADRC'.includes(file.code.charAt(0))) staged.push(file)\r\n 517       if ('MD'.includes(file.code.charAt(1))) unstaged.push(file)\r\n 518     }\r\n 519   }\r\n 520   return {\r\n 521     branch: porcelain.branch,\r\n 522     upstream: porcelain.upstream,\r\n 523     ahead: porcelain.ahead,\r\n 524     behind: porcelain.behind,\r\n 525     staged,\r\n 526     unstaged,\r\n 527     untracked,\r\n 528     conflicts,\r\n 529     added: worktreeNumstat.added + cachedNumstat.added,\r\n 530     removed: worktreeNumstat.removed + cachedNumstat.removed,\r\n 531     fetchedAt,\r\n 532   }\r\n 533 }\r\n 534 \r\n 535 /** 工作区干净且与上游同步；此时横条不画 git 行 */\r\n 536 export function isGitQuiet(status: GitStatus): boolean {\r\n 537   return (\r\n 538     status.staged.length === 0 &&\r\n 539     status.unstaged.length === 0 &&\r\n 540     status.untracked.length === 0 &&\r\n 541     status.conflicts.length === 0 &&\r\n 542     status.ahead === 0 &&\r\n 543     status.behind === 0\r\n 544   )\r\n 545 }\r\n 546 \r\n 547 /** 横条 git 行的计数段与行级段文案；各自无内容时为 null（冲突计数由渲染层独立红字展示） */\r\n 548 export function gitSummaryParts(\r\n 549   status: GitStatus,\r\n 550 ): { counts: string | null; lines: string | null } {\r\n 551   const counts: string[] = []\r\n 552   if (status.staged.length > 0) counts.push(`暂存${status.staged.length}`)\r\n 553   if (status.unstaged.length > 0) counts.push(`改${status.unstaged.length}`)\r\n 554   if (status.untracked.length > 0) counts.push(`新${status.untracked.length}`)\r\n 555   let lines: string | null = null\r\n 556   if (status.added > 0 && status.removed > 0) lines = `+${status.added} −${status.removed}`\r\n 557   else if (status.added > 0) lines = `+${status.added}`\r\n 558   else if (status.removed > 0) lines = `−${status.removed}`\r\n 559   return { counts: counts.length === 0 ? null : counts.join(' '), lines }\r\n 560 }\r\n 561 \r\n 562 /** 文档浏览面板单节渲染的行数上限；超长节截断显示，草稿行号仍用全节范围 */\r\n 563 export const DOC_SECTION_MAX_LINES = 60\r\n 564 \r\n 565 /** 文档浏览面板全文模式的行数上限（Pane 内容超高时引擎侧可滚动） */\r\n 566 export const DOC_ALL_MAX_LINES = 400\r\n 567 \r\n 568 /** 文档浏览面板的一个节（行号 1 起且双端包含） */\r\n 569 export type DocSection = {\r\n 570   /** 节标题（# 号后的文字）；文档开头正文为「开头」，无标题整篇为「全文」 */\r\n 571   title: string\r\n 572   /** 标题层级 1-6；合成节为 0 */\r\n 573   level: number\r\n 574   start: number\r\n 575   end: number\r\n 576 }\r\n 577 \r\n 578 /** 按 markdown 标题把文档切为节。fenced code block 内的 # 不算标题（``` 与\r\n 579  *  ~~~ 行翻转围栏状态，闭栏不校验同字符同长度）。首个标题前的正文成「开头」\r\n 580  *  节（纯空白行不设节）；无标题且非空时整篇为「全文」节；空文本返回空数组。 */\r\n 581 export function parseSections(text: string): DocSection[] {\r\n 582   const lines = text.split('\\n')\r\n 583   const headings: { line: number; title: string; level: number }[] = []\r\n 584   let fence = false\r\n 585   for (let i = 0; i < lines.length; i++) {\r\n 586     if (/^ {0,3}(```|~~~)/.test(lines[i])) {\r\n 587       fence = !fence\r\n 588       continue\r\n 589     }\r\n 590     if (fence) continue\r\n\r\n### plugins/flow-deck/hooks/poll.ts\r\n   1 import type { FsEntry } from 'claude-code'\r\n   2 import { buildGitStatus, buildPlanReview, extractRound, parseNumstat, parsePorcelain } from './parse'\r\n   3 import type { GitStatus, PlanReview } from '../types'\r\n   4 \r\n   5 export const DISCOVERY_MS = 30_000\r\n   6 export const GIT_ACTIVE_MS = 5_000\r\n   7 export const GIT_IDLE_MS = 15_000\r\n   8 export const GIT_RETRY_MS = 60_000\r\n   9 const SKIP_DIRS = new Set(['node_modules', '.git', '.venv', 'venv', '__pycache__', 'dist', 'build'])\r\n  10 \r\n  11 /** 慢查询未完成时跳过后续 tick；失败后仍允许下一轮重试。 */\r\n  12 export function singleFlight(task: () => Promise<void>): () => Promise<void> {\r\n  13   let busy = false\r\n  14   return async () => {\r\n  15     if (busy) return\r\n  16     busy = true\r\n  17     try {\r\n  18       await task()\r\n  19     } finally {\r\n  20       busy = false\r\n  21     }\r\n  22   }\r\n  23 }\r\n  24 \r\n  25 /** 仅发现目录时遍历项目；平时只查看已知评审根，按文件元数据缓存解析结果。 */\r\n  26 export function createPlanScanner(fs: {\r\n  27   list: (path?: string) => Promise<FsEntry[]>\r\n  28   read: (path: string) => Promise<string>\r\n  29 }) {\r\n  30   let roots = new Set<string>()\r\n  31   let discoveredAt = -Infinity\r\n  32   const cache = new Map<string, { signature: string; plan: PlanReview }>()\r\n  33 \r\n  34   async function list(path: string) {\r\n  35     try {\r\n  36       return path === '' ? await fs.list() : await fs.list(path)\r\n  37     } catch {\r\n  38       return []\r\n  39     }\r\n  40   }\r\n  41 \r\n  42   async function discover(rel: string, depth: number, found: Set<string>): Promise<void> {\r\n  43     if (depth > 4) return\r\n  44     for (const entry of await list(rel)) {\r\n  45       if (entry.kind !== 'dir' || SKIP_DIRS.has(entry.name)) continue\r\n  46       const child = rel === '' ? entry.name : `${rel}/${entry.name}`\r\n  47       if (entry.name === '.plan-iterate') found.add(child)\r\n  48       else await discover(child, depth + 1, found)\r\n  49     }\r\n  50   }\r\n  51 \r\n  52   return async (now: number): Promise<PlanReview[]> => {\r\n  53     if (now - discoveredAt >= DISCOVERY_MS) {\r\n  54       const found = new Set<string>()\r\n  55       await discover('', 0, found)\r\n  56       roots = found\r\n  57       discoveredAt = now\r\n  58     }\r\n  59     const plans: PlanReview[] = []\r\n  60     const live = new Set<string>()\r\n  61     for (const root of roots) {\r\n  62       for (const entry of await list(root)) {\r\n  63         if (entry.kind !== 'dir') continue\r\n  64         const dir = `${root}/${entry.name}`\r\n  65         live.add(dir)\r\n  66         try {\r\n  67           const files = (await fs.list(dir))\r\n  68             .filter(file => file.kind === 'file' && (file.name === 'state.json' || extractRound(file.name) !== null))\r\n  69             .sort((a, b) => a.name.localeCompare(b.name))\r\n  70           if (!files.some(file => file.name === 'state.json')) continue\r\n  71           const stamps = files.map(file => [file.name, file.mtimeMs, file.size])\r\n  72           const signature = JSON.stringify(stamps)\r\n  73           const cached = cache.get(dir)\r\n  74           if (cached?.signature === signature) {\r\n  75             plans.push(cached.plan)\r\n  76             continue\r\n  77           }\r\n  78           const reviews = []\r\n  79           let state = ''\r\n  80           for (const file of files) {\r\n  81             const text = await fs.read(`${dir}/${file.name}`)\r\n  82             if (file.name === 'state.json') state = text\r\n  83             else reviews.push({ round: extractRound(file.name)!, text })\r\n  84           }\r\n  85           const plan = buildPlanReview(entry.name, dir, state, reviews)\r\n  86           cache.set(dir, { signature, plan })\r\n  87           plans.push(plan)\r\n  88         } catch {\r\n  89           // 原子替换/删除中的文件留待下一轮；不将半次读取写入缓存。\r\n  90           const cached = cache.get(dir)\r\n  91           if (cached) plans.push(cached.plan)\r\n  92         }\r\n  93       }\r\n  94     }\r\n  95     for (const dir of cache.keys()) if (!live.has(dir)) cache.delete(dir)\r\n  96     return plans.sort((a, b) => a.name.localeCompare(b.name) || a.dir.localeCompare(b.dir))\r\n  97   }\r\n  98 }\r\n  99 \r\n 100 /** 时间戳不参与比较，避免仅取数时间变化就触发整棵 UI 刷新。 */\r\n 101 export function gitSnapshotKey(status: GitStatus | null): string {\r\n 102   if (status === null) return 'null'\r\n 103   const { fetchedAt, ...visible } = status\r\n 104   void fetchedAt\r\n 105   return JSON.stringify(visible)\r\n 106 }\r\n 107 \r\n 108 export function createGitPoller(\r\n 109   run: (args: readonly string[]) => Promise<string | null>,\r\n 110   publish: (status: GitStatus | null) => Promise<void>,\r\n 111 ) {\r\n 112   let nextAt = -Infinity\r\n 113   let previous: string | undefined\r\n 114   let inFlight: Promise<void> | undefined\r\n 115   async function poll(now: number, force: boolean): Promise<void> {\r\n 116     if (!force && now < nextAt) return\r\n 117     const text = await run(['--no-optional-locks', '-c', 'core.quotePath=false', 'status', '--porcelain=v1', '-b'])\r\n 118     let status: GitStatus | null = null\r\n 119     if (text !== null) {\r\n 120       const porcelain = parsePorcelain(text)\r\n 121       if (porcelain === null) return\r\n 122       // 无对应 tracked 更改时省掉 diff；不按 porcelain 缓存行数，同一 M 状态内容仍会变化。\r\n 123       const base = buildGitStatus(porcelain, { added: 0, removed: 0 }, { added: 0, removed: 0 }, now)\r\n 124       const [worktree, cached] = await Promise.all([\r\n 125         base.unstaged.length + base.conflicts.length > 0 ? run(['diff', '--no-ext-diff', '--no-textconv', '--numstat']) : null,\r\n 126         base.staged.length > 0 ? run(['diff', '--cached', '--no-ext-diff', '--no-textconv', '--numstat']) : null,\r\n 127       ])\r\n 128       status = buildGitStatus(porcelain, parseNumstat(worktree ?? ''), parseNumstat(cached ?? ''), now)\r\n 129       nextAt = now + (porcelain.files.length > 0 ? GIT_ACTIVE_MS : GIT_IDLE_MS)\r\n 130     } else {\r\n 131       nextAt = now + GIT_RETRY_MS\r\n 132     }\r\n 133     const key = gitSnapshotKey(status)\r\n 134     if (key !== previous) {\r\n 135       await publish(status)\r\n 136       previous = key\r\n 137     }\r\n 138   }\r\n 139   return (now: number, force = false): Promise<void> => {\r\n 140     if (inFlight) return inFlight\r\n 141     inFlight = poll(now, force).finally(() => { inFlight = undefined })\r\n 142     return inFlight\r\n 143   }\r\n 144 }\r\n\r\n### plugins/flow-deck/types/index.d.ts\r\n   1 /** plan-iterate 单轮评审结果摘要（源自 review-RN.json） */\r\n   2 export type ReviewRound = {\r\n   3   round: number\r\n   4   score: number\r\n   5   p0: number\r\n   6   p1: number\r\n   7   p2: number\r\n   8 }\r\n   9 \r\n  10 /** 一个方案的评审概览（源自 .plan-iterate/<plan名>/ 下的落盘文件） */\r\n  11 export type PlanReview = {\r\n  12   /** 方案名（.plan-iterate 下的目录名） */\r\n  13   name: string\r\n  14   /** .plan-iterate/<plan名> 的路径（相对会话工作目录） */\r\n  15   dir: string\r\n  16   /** 方案文档路径（state.json 的 plan_path 原文，可为绝对路径）；缺失则面板不可点击跳转 */\r\n  17   docPath?: string\r\n  18   /** 评审后端（state.json 的 backend 字段） */\r\n  19   backend?: string\r\n  20   /** 当前轮次（state.json 的 round 字段，缺失时取最新评审轮） */\r\n  21   round: number\r\n  22   /** 已落盘的各轮评审，按轮次升序 */\r\n  23   rounds: ReviewRound[]\r\n  24   /** 最新轮是否达标（score >= 8.5 且无 P0/P1） */\r\n  25   passed: boolean\r\n  26 }\r\n  27 \r\n  28 /** $.agent.list() 的展示字段；manifest 类型契约必须自包含 */\r\n  29 export type SubagentInfo = {\r\n  30   id: string\r\n  31   description: string\r\n  32   type: string\r\n  33   status: string\r\n  34   parentId?: string\r\n  35   spawnedBy?: string\r\n  36   name?: string\r\n  37 }\r\n  38 \r\n  39 /** 宿主当前会话的子代理清单及读取状态 */\r\n  40 export type AgentSnapshot = {\r\n  41   agents: SubagentInfo[]\r\n  42   loaded: boolean\r\n  43   /** 查询失败时保留上次清单；面板需提示状态可能已过期 */\r\n  44   error: boolean\r\n  45 }\r\n  46 \r\n  47 /** 当前会话任务，与历史评审及执行记录分开保存 */\r\n  48 export type FlowTask = {\r\n  49   kind: 'iterate' | 'implement'\r\n  50   plan: string\r\n  51   batch?: string\r\n  52 }\r\n  53 \r\n  54 /** 一条 implement-plan 执行进度上报（源自 flow_report 工具调用） */\r\n  55 export type ExecutionReport = {\r\n  56   /** 方案名（方案文档文件名去扩展名） */\r\n  57   plan: string\r\n  58   /** 批次标识，如 B2 */\r\n  59   batch: string\r\n  60   /** 当前阶段：开工 | 派单 | 执行 | 验证 | 收口 */\r\n  61   phase: string\r\n  62   /** 风险定级：T0-T3 */\r\n  63   tLevel?: string\r\n  64   /** 已通过的定向测试数 */\r\n  65   testsPassed?: number\r\n  66   /** 定向测试总数 */\r\n  67   testsTotal?: number\r\n  68   /** 证据目录路径 */\r\n  69   evidenceDir?: string\r\n  70   /** 上报时间（ms）；$.store 旧值缺失时为 0 */\r\n  71   updatedAt: number\r\n  72 }\r\n  73 \r\n  74 /** 一个批次的改动边界（源自 flow_batch 工具声明） */\r\n  75 export type BatchScope = {\r\n  76   /** 方案名 */\r\n  77   plan: string\r\n  78   /** 批次标识，如 B2 */\r\n  79   batch: string\r\n  80   /** 本批允许改动的文件集合（经路径归一化，相对会话工作目录） */\r\n  81   files: string[]\r\n  82 }\r\n  83 \r\n  84 /** 一个批次的依赖节点（源自 flow_deps 工具声明） */\r\n  85 export type BatchDep = {\r\n  86   /** 批次标识，如 B2 */\r\n  87   batch: string\r\n  88   /** 依赖的前置批次标识列表 */\r\n  89   dependsOn: string[]\r\n  90 }\r\n  91 \r\n  92 /** 一个方案的波次依赖图（按推荐执行顺序排列） */\r\n  93 export type DepGraph = {\r\n  94   /** 方案名 */\r\n  95   plan: string\r\n  96   /** 批次依赖节点，按推荐执行顺序 */\r\n  97   batches: BatchDep[]\r\n  98 }\r\n  99 \r\n 100 /** 一个 git 文件的更改状态（源自 git status --porcelain 的 XY 码） */\r\n 101 export type GitFileState = {\r\n 102   /** 原始 XY 码，如 ' M'、'M '、'??'、'UU' */\r\n 103   code: string\r\n 104   /** 文件路径（rename 为新路径） */\r\n 105   path: string\r\n 106   /** rename 原路径 */\r\n 107   oldPath?: string\r\n 108 }\r\n 109 \r\n 110 /** 一次 git 仓库状态快照（源自 status --porcelain=v1 -b 与 diff --numstat） */\r\n 111 export type GitStatus = {\r\n 112   /** 当前分支名；detached HEAD 时为 'HEAD*' */\r\n 113   branch: string\r\n 114   /** 上游分支名；未设置或 unborn 时为 null */\r\n 115   upstream: string | null\r\n 116   /** 领先上游的提交数 */\r\n 117   ahead: number\r\n 118   /** 落后上游的提交数 */\r\n 119   behind: number\r\n 120   /** 已暂存的文件（X ∈ M/A/D/R/C 且非冲突） */\r\n 121   staged: GitFileState[]\r\n 122   /** 未暂存的改动文件（Y ∈ M/D 且非冲突） */\r\n 123   unstaged: GitFileState[]\r\n 124   /** 未跟踪的文件（??） */\r\n 125   untracked: GitFileState[]\r\n 126   /** 合并冲突文件（UU/AA/DD/AU/UA/DU/UD），最优先展示 */\r\n 127   conflicts: GitFileState[]\r\n 128   /** 行级新增合计（tracked 改动，untracked 不计） */\r\n 129   added: number\r\n 130   /** 行级删除合计 */\r\n 131   removed: number\r\n 132   /** 快照时间（ms） */\r\n 133   fetchedAt: number\r\n 134 }\r\n 135 \r\n 136 /** $.fs.list() 的展示字段子集（文件树面板） */\r\n 137 export type FsEntryLike = {\r\n 138   name: string\r\n 139   kind: string\r\n 140   isLink: boolean\r\n 141 }\r\n 142 \r\n 143 declare module 'claude-code' {\r\n 144   interface PluginState {\r\n 145     'flow-deck': {\r\n 146       /** 最近一次扫描发现的所有方案评审概览 */\r\n 147       plans: PlanReview[]\r\n 148       /** 已通知过的 plan+轮次组合键（<dir>#R<n>），防止重复 toast */\r\n 149       notified: string[]\r\n 150       /** 首次扫描已把存量评审静默标记为已通知 */\r\n 151       baselined: boolean\r\n 152       /** 当前会话正在进行的任务；历史文件、依赖声明不会激活任务 */\r\n 153       currentTask: FlowTask | null\r\n 154       /** 本会话最近一次执行上报；无则 null */\r\n 155       execution: ExecutionReport | null\r\n 156       /** 当前批次改动边界；未声明则 null（守卫放行） */\r\n 157       batchScope: BatchScope | null\r\n 158       /** 已越界提醒过的归一化路径键，同批同文件不重复告警；批次重声明或新会话时清空 */\r\n 159       guardWarned: string[]\r\n 160       /** 各批次最新阶段，键 <plan>#<batch>，flow_report 逐批累积 */\r\n 161       progress: Record<string, string>\r\n 162       /** 当前方案的波次依赖图；未声明则 null */\r\n 163       deps: DepGraph | null\r\n 164       /** 最近一次 git 仓库状态快照；非 git 仓库或尚未取数则 null */\r\n 165       git: GitStatus | null\r\n 166       /** 宿主当前会话的子代理状态，仅打开面板时查询 */\r\n 167       agents: AgentSnapshot\r\n 168       /** 跨会话恢复的上次执行摘要（源自 $.store），空态面板的面包屑；无则 null */\r\n 169       lastRun: ExecutionReport | null\r\n 170       /** 执行停滞提示：距上次上报的分钟数（超过阈值）；未停滞或无执行则 null */\r\n 171       stall: number | null\r\n 172       /** 文档浏览面板装载的文档；text 为 null 表示读取失败（error 记原因） */\r\n 173       doc: { path: string; text: string | null; error?: string } | null\r\n 174       /** 文档浏览面板当前选中节在 parseSections 结果中的下标 */\r\n 175       docSection: number\r\n 176       /** 文档浏览模式：all 全文阅读（默认），section 单节浏览（修改请求锚定） */\r\n 177       docMode: 'all' | 'section'\r\n 178       /** 文件树面板当前浏览目录（相对会话工作目录）；null 表示根 */\r\n 179       treeDir: string | null\r\n 180       /** 文件树面板最近一次目录列表；loaded 表示已取数（含空目录） */\r\n 181       treeEntries: { entries: FsEntryLike[]; loaded: boolean } | null\r\n 182       /** 本会话 Edit/Write 改动记录（去重保序，上限 50，最新在末尾） */\r\n 183       touched: { path: string; at: number }[]\r\n 184       /** deck 面板当前页签；/deck 无参打开时保持上次所在页签 */\r\n 185       activeTab: 'flow' | 'files' | 'doc'\r\n 186     }\r\n 187   }\r\n 188 }\r\n","exit_code":0,"status":"completed"}}
