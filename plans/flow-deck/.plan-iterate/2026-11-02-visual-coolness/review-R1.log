ch',\r\n821:       description:\r\n822:         'implement-plan 批次边界声明。每批开工时调用一次，声明本批允许改动的文件集合' +\r\n823:         '（来自委派单的改动锚点）；此后本批对边界外文件的编辑会被守卫拦截或提醒。',\r\n824:       inputSchema: {\r\n825:         type: 'object',\r\n826:         properties: {\r\n827:           plan: { type: 'string', description: '方案名（方案文档文件名去扩展名）' },\r\n828:           batch: { type: 'string', description: '批次标识，如 B2' },\r\n829:           files: {\r\n830:             type: 'array',\r\n831:             items: { type: 'string' },\r\n832:             description: '本批允许改动的文件路径（相对会话工作目录或绝对路径）',\r\n833:           },\r\n834:         },\r\n835:         required: ['plan', 'batch', 'files'],\r\n836:       },\r\n837:     })\r\n838:     await $.tool.register({\r\n839:       name: 'flow_deps',\r\n840:       description:\r\n841:         'optimization-plan 波次依赖声明。路线图定稿时调用一次，把波次依赖图声明为机器可读' +\r\n842:         '清单；仪表盘面板将按推荐执行顺序绘制执行进度图。',\r\n843:       inputSchema: {\r\n844:         type: 'object',\r\n845:         properties: {\r\n846:           plan: { type: 'string', description: '方案名（方案文档文件名去扩展名）' },\r\n847:           batches: {\r\n848:             type: 'array',\r\n849:             description: '批次依赖节点，按推荐执行顺序排列',\r\n850:             items: {\r\n851:               type: 'object',\r\n852:               properties: {\r\n853:                 batch: { type: 'string', description: '批次标识，如 B2' },\r\n854:                 dependsOn: {\r\n855:                   type: 'array',\r\n856:                   items: { type: 'string' },\r\n857:                   description: '依赖的前置批次标识列表',\r\n858:                 },\r\n859:               },\r\n860:               required: ['batch'],\r\n861:             },\r\n862:           },\r\n863:         },\r\n864:         required: ['plan', 'batches'],\r\n865:       },\r\n866:     })\r\n867:     const last = await readLastExecution($)\r\n868:     await update($, lastRun, () => last)\r\n869:     if (last !== null) $.ui.toast(`上次执行：${describeExecution(last)}`)\r\n870:     const refreshPlans = singleFlight(async () => {\r\n871:       try {\r\n872:         await poll($)\r\n873:       } catch (error) {\r\n874:         $.ui.log(String(error), { to: 'debug' })\r\n875:       }\r\n876:     })\r\n877:     const gitPoller = createGitPoller(args => runGit($, args), async status => {\r\n878:       await update($, gitStatus, () => status)\r\n879:     })\r\n880:     const tickGit = singleFlight(async () => {\r\n881:       try {\r\n882:         await gitPoller(Date.now())\r\n883:       } catch (error) {\r\n884:         $.ui.log(String(error), { to: 'debug' })\r\n885:       }\r\n886:     })\r\n887:     refreshGit = singleFlight(async () => {\r\n888:       await gitPoller(Date.now(), true)\r\n889:     })\r\n890:     const refreshAgentList = createAgentPoller(() => $.agent.list(), async snapshot => {\r\n891:       await update($, agents, () => snapshot)\r\n892:     })\r\n893:     refreshAgents = refreshAgentList\r\n894:     const refreshAgentPane = async () => {\r\n895:       try {\r\n896:         if ((await $.ui.panes()).some(pane => pane.id === DECK_PANE_ID)) await refreshAgentList()\r\n897:       } catch (error) {\r\n898:         $.ui.log(`flow-deck 子代理刷新失败：${String(error)}`, { to: 'debug' })\r\n899:       }\r\n900:     }\r\n901:     void refreshPlans()\r\n902:     void tickGit()\r\n903:     refreshAll = () => {\r\n904:       void refreshPlans()\r\n905:       void refreshGit?.()\r\n906:       void refreshAgents?.()\r\n907:     }\r\n908:     planTimer = $.clock.every(POLL_MS, async () => {\r\n909:       await Promise.all([refreshPlans(), refreshAgentPane(), refreshStall($)])\r\n910:     })\r\n911:     gitTimer = $.clock.every(GIT_POLL_MS, tickGit)\r\n912:     return next(e)\r\n913:   })\r\n914: \r\n915:   on('command.run', { command: 'deck' }, async ($, e) => {\r\n916:     const arg = e.args.trim()\r\n917:     const isOpen = (await $.ui.panes()).some(pane => pane.id === DECK_PANE_ID)\r\n918:     if (arg === '') {\r\n919:       if (isOpen) {\r\n920:         await $.ui.close({ id: DECK_PANE_ID })\r\n921:         manualDeck = true\r\n922:         return { text: '已关闭 flow-deck 面板。' }\r\n923:       }\r\n924:       manualDeck = true\r\n925:       const note = await openDeckPane($)\r\n926:       void refreshAgents?.().catch(error => {\r\n927:         $.ui.log(`flow-deck 子代理刷新失败：${String(error)}`, { to: 'debug' })\r\n928:       })\r\n929:       return { text: `已打开面板（1 工作流 · 2 文件 · 3 文档，Esc 回输入框）${note}。` }\r\n930:     }\r\n931:     if (arg === 'flow' || arg === 'tree') {\r\n932:       await update($, activeTab, () => arg === 'tree' ? 'files' : 'flow')\r\n933:       if (arg === 'tree') await loadTree($, null)\r\n934:       manualDeck = true\r\n935:       const note = isOpen ? '' : await openDeckPane($)\r\n936:       return { text: `${arg === 'tree' ? '已切到文件树页签' : '已切到工作面板页签'}${note}。` }\r\n937:     }\r\n938:     if (arg === 'doc' || arg.startsWith('doc ')) {\r\n939:       const path = arg.slice(3).trim()\r\n940:       if (path !== '') {\r\n941:         await loadDoc($, path)\r\n942:         await update($, activeTab, () => 'doc')\r\n943:         manualDeck = true\r\n944:         const note = isOpen ? '' : await openDeckPane($)\r\n945:         return { text: `文档已装载：${path}${note}` }\r\n946:       }\r\n947:       await update($, activeTab, () => 'doc')\r\n948:       manualDeck = true\r\n949:       const note = isOpen ? '' : await openDeckPane($)\r\n950:       return { text: `已切到文件查看器页签；装载文档用 /deck doc <相对路径>${note}。` }\r\n951:     }\r\n952:     return { text: '用法：/deck [flow|tree|doc [相对路径]]' }\r\n953:   })\r\n954: \r\n955:   on('tool.call', { tool: 'mcp__flow-deck__flow_task' }, async ($, e) => {\r\n956:     if (e.kind !== 'iterate' && e.kind !== 'implement' && e.kind !== 'idle') {\r\n957:       return { result: 'kind 必须为 iterate、implement 或 idle', isError: true }\r\n958:     }\r\n959:     if (e.kind !== 'idle' && (typeof e.plan !== 'string' || e.plan.trim() === '')) {\r\n960:       return { result: '活动任务必须提供 plan', isError: true }\r\n961:     }\r\n962:     const task: FlowTask | null = e.kind === 'idle' ? null : {\r\n963:       kind: e.kind, plan: e.plan as string,\r\n964:       ...(typeof e.batch === 'string' && e.batch !== '' ? { batch: e.batch } : {}),\r\n965:     }\r\n966:     await update($, execution, () => null)\r\n967:     await update($, batchScope, () => null)\r\n968:     await update($, currentTask, () => task)\r\n969:     lastStatus = undefined\r\n970:     $.ui.status(undefined)\r\n971:     return { result: task === null ? '当前任务已结束' : `当前任务：${task.kind === 'iterate' ? '方案迭代' : '方案实施'} · ${task.plan}` }\r\n972:   })\r\n973: \r\n974:   on('tool.call', { tool: 'mcp__flow-deck__flow_report' }, async ($, e) => {\r\n975:     const report = parseExecution(e)\r\n976:     if (report === null) {\r\n977:       return { result: 'plan、batch、phase 为必填字符串', isError: true }\r\n978:     }\r\n979:     const stamped: ExecutionReport = { ...report, updatedAt: Date.now() }\r\n980:     await update($, execution, () => stamped)\r\n981:     await update($, progress, prev => ({\r\n982:       ...prev,\r\n983:       [`${stamped.plan}#${stamped.batch}`]: stamped.phase,\r\n984:     }))\r\n985:     await update($, currentTask, () => stamped.phase === '收口' ? null : {\r\n986:       kind: 'implement', plan: stamped.plan, batch: stamped.batch,\r\n987:     })\r\n988:     const scope = await read($, batchScope)\r\n989:     if (stamped.phase === '收口' || (scope !== null && (scope.plan !== stamped.plan || scope.batch !== stamped.batch))) {\r\n990:       await update($, batchScope, () => null)\r\n991:     }\r\n992:     lastStatus = undefined\r\n993:     $.ui.status(undefined)\r\n994:     try {\r\n995:       await $.store.set(EXECUTION_STORE_KEY, stamped)\r\n996:     } catch (error) {\r\n997:       $.ui.log(`flow-deck 跨会话持久化失败：${String(error)}`, { to: 'debug' })\r\n998:     }\r\n999:     return { result: '进度已上报' }\r\n1000:   })\r\n1001: \r\n1002:   on('tool.call', { tool: 'mcp__flow-deck__flow_batch' }, async ($, e) => {\r\n1003:     const scope = parseBatchScope(e)\r\n1004:     if (scope === null) {\r\n1005:       return { result: 'plan、batch 为必填字符串，files 为非空字符串数组', isError: true }\r\n1006:     }\r\n1007:     await update($, batchScope, () => scope)\r\n1008:     // 边界变了越界集合随之变化，应允许再次提醒\r\n1009:     await update($, guardWarned, () => [])\r\n1010:     await update($, currentTask, () => ({ kind: 'implement', plan: scope.plan, batch: scope.batch }))\r\n1011:     lastStatus = undefined\r\n1012:     $.ui.status(undefined)\r\n1013:     return { result: `批次边界已声明：${scope.batch} 共 ${scope.files.length} 个文件` }\r\n1014:   })\r\n1015: \r\n1016:   on('tool.call', { tool: 'mcp__flow-deck__flow_deps' }, async ($, e) => {\r\n1017:     const graph = parseDepGraph(e)\r\n1018:     if (graph === null || graph.batches.length === 0) {\r\n1019:       return { result: 'plan 为必填字符串，batches 为非空数组（每项含 batch）', isError: true }\r\n1020:     }\r\n","exit_code":0,"status":"completed"}}
