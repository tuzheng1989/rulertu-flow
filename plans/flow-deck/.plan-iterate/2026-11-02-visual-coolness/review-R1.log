\n 747         <Button key=\"tree-reload\" hotkey=\"r\" plain onPress={() => { void loadTree($, dir) }}>重读</Button>\r\n 748       </Box>\r\n 749       <Text dimColor wrap=\"truncate-end\">/deck 关闭 · 点目录进入 · 点文件看文档 · ● 本会话 ○ 其他 · r 重读目录</Text>\r\n 750     </Box>\r\n 751   )\r\n 752 }\r\n 753 \r\n 754 export const register: Register = (on, options) => {\r\n 755   guardMode = options.guardMode === 'deny' ? 'deny' : 'warn'\r\n 756   autoOpenMode = options.autoOpen === 'off' ? 'off' : 'on'\r\n 757 \r\n 758   on('session.start', async ($, e, next) => {\r\n 759     sessionCwd = e.cwd\r\n 760     lastStatus = undefined\r\n 761     await update($, currentTask, () => null)\r\n 762     await update($, execution, () => null)\r\n 763     await update($, batchScope, () => null)\r\n 764     await update($, plans, () => [])\r\n 765     await update($, notified, () => [])\r\n 766     await update($, guardWarned, () => [])\r\n 767     await update($, baselined, () => false)\r\n 768     await update($, progress, () => ({}))\r\n 769     await update($, deps, () => null)\r\n 770     await update($, agents, () => ({ agents: [], loaded: false, error: false }))\r\n 771     await update($, stall, () => null)\r\n 772     await update($, docFile, () => null)\r\n 773     await update($, docSection, () => 0)\r\n 774     await update($, docMode, () => 'all')\r\n 775     await update($, treeDir, () => null)\r\n 776     await update($, treeEntries, () => null)\r\n 777     await update($, touched, () => [])\r\n 778     autoOpened = false\r\n 779     manualDeck = false\r\n 780     planTimer?.cancel()\r\n 781     gitTimer?.cancel()\r\n 782     scanPlans = createPlanScanner({\r\n 783       list: path => path === undefined ? $.fs.list() : $.fs.list(path),\r\n 784       read: path => $.fs.read(path),\r\n 785     })\r\n 786     await $.command.register({ name: 'deck', description: '开关 flow-deck 面板：/deck 直开，/deck flow|tree|doc [路径] 直达页签' })\r\n 787     await $.tool.register({\r\n 788       name: 'flow_task',\r\n 789       description: '声明当前工作流任务：iterate 方案迭代，implement 方案实施，idle 结束、暂停或取消。历史评审和路线图不会自动激活面板。',\r\n 790       inputSchema: {\r\n 791         type: 'object',\r\n 792         properties: {\r\n 793           kind: { type: 'string', enum: ['iterate', 'implement', 'idle'] },\r\n 794           plan: { type: 'string', description: '方案名；iterate 使用 .plan-iterate 下的目录名，idle 时可省略' },\r\n 795           batch: { type: 'string', description: '实施批次（可选）' },\r\n 796         },\r\n 797         required: ['kind'],\r\n 798       },\r\n 799     })\r\n 800     await $.tool.register({\r\n 801       name: 'flow_report',\r\n 802       description:\r\n 803         'implement-plan 执行进度上报。每完成一个阶段（开工/派单/执行/验证/收口）调用一次；' +\r\n 804         '进度会实时显示在输入框上方横条，并跨会话保留以便续接。',\r\n 805       inputSchema: {\r\n 806         type: 'object',\r\n 807         properties: {\r\n 808           plan: { type: 'string', description: '方案名（方案文档文件名去扩展名）' },\r\n 809           batch: { type: 'string', description: '批次标识，如 B2' },\r\n 810           phase: { type: 'string', description: '当前阶段：开工 | 派单 | 执行 | 验证 | 收口' },\r\n 811           tLevel: { type: 'string', description: '风险定级：T0 | T1 | T2 | T3' },\r\n 812           testsPassed: { type: 'number', description: '已通过的定向测试数' },\r\n 813           testsTotal: { type: 'number', description: '定向测试总数' },\r\n 814           evidenceDir: { type: 'string', description: '证据目录路径' },\r\n 815         },\r\n 816         required: ['plan', 'batch', 'phase'],\r\n 817       },\r\n 818     })\r\n 819     await $.tool.register({\r\n 820       name: 'flow_batch',\r\n 821       description:\r\n 822         'implement-plan 批次边界声明。每批开工时调用一次，声明本批允许改动的文件集合' +\r\n 823         '（来自委派单的改动锚点）；此后本批对边界外文件的编辑会被守卫拦截或提醒。',\r\n 824       inputSchema: {\r\n 825         type: 'object',\r\n 826         properties: {\r\n 827           plan: { type: 'string', description: '方案名（方案文档文件名去扩展名）' },\r\n 828           batch: { type: 'string', description: '批次标识，如 B2' },\r\n 829           files: {\r\n 830             type: 'array',\r\n 831             items: { type: 'string' },\r\n 832             description: '本批允许改动的文件路径（相对会话工作目录或绝对路径）',\r\n 833           },\r\n 834         },\r\n 835         required: ['plan', 'batch', 'files'],\r\n 836       },\r\n 837     })\r\n 838     await $.tool.register({\r\n 839       name: 'flow_deps',\r\n 840       description:\r\n 841         'optimization-plan 波次依赖声明。路线图定稿时调用一次，把波次依赖图声明为机器可读' +\r\n 842         '清单；仪表盘面板将按推荐执行顺序绘制执行进度图。',\r\n 843       inputSchema: {\r\n 844         type: 'object',\r\n 845         properties: {\r\n 846           plan: { type: 'string', description: '方案名（方案文档文件名去扩展名）' },\r\n 847           batches: {\r\n 848             type: 'array',\r\n 849             description: '批次依赖节点，按推荐执行顺序排列',\r\n 850             items: {\r\n 851               type: 'object',\r\n 852               properties: {\r\n 853                 batch: { type: 'string', description: '批次标识，如 B2' },\r\n 854                 dependsOn: {\r\n 855                   type: 'array',\r\n 856                   items: { type: 'string' },\r\n 857                   description: '依赖的前置批次标识列表',\r\n 858                 },\r\n 859               },\r\n 860               required: ['batch'],\r\n 861             },\r\n 862           },\r\n 863         },\r\n 864         required: ['plan', 'batches'],\r\n 865       },\r\n 866     })\r\n 867     const last = await readLastExecution($)\r\n 868     await update($, lastRun, () => last)\r\n 869     if (last !== null) $.ui.toast(`上次执行：${describeExecution(last)}`)\r\n 870     const refreshPlans = singleFlight(async () => {\r\n 871       try {\r\n 872         await poll($)\r\n 873       } catch (error) {\r\n 874         $.ui.log(String(error), { to: 'debug' })\r\n 875       }\r\n 876     })\r\n 877     const gitPoller = createGitPoller(args => runGit($, args), async status => {\r\n 878       await update($, gitStatus, () => status)\r\n 879     })\r\n 880     const tickGit = singleFlight(async () => {\r\n 881       try {\r\n 88